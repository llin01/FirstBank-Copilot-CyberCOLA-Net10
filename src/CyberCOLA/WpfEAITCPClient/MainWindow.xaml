<Window x:Class="Com.Cybersoft4u.Test.WpfEAITCPClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="EAI Client Simulator" Height="500" Width="800" Icon="eai.ico"  >
    <Grid>
        <DockPanel MinHeight="50" MinWidth="50" LastChildFill="True" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Column="0" Grid.ColumnSpan="1" Grid.Row="0" Grid.RowSpan="1" Margin="0,0,0,0" Width="NaN" Height="NaN" Name="dockPanel1">
            <!--Definition-->
            <StatusBar DockPanel.Dock="Bottom">
                <StatusBar.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </ItemsPanelTemplate>
                </StatusBar.ItemsPanel>
                <StatusBarItem>
                    <TextBlock Name="TextBlockMessage" Text="Ready" Foreground="Red"/>
                </StatusBarItem>
                <StatusBarItem Grid.Column="1">
                    <TextBlock Name="TextBlockTime" Text="Time"  Foreground="Blue"/>
                </StatusBarItem>
            </StatusBar>
            <Grid>
                <Grid.RowDefinitions >
                    <RowDefinition Height="3*" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions >
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <!--Panel-->
                <Border Grid.Row="0" Grid.Column="0" Background="LightGreen" >
                    <GroupBox x:Name="Message1" Header="Message1" Margin="0,0,-0.333,0" >
                        <RichTextBox x:Name="RichTextBox1" HorizontalAlignment="Stretch" Margin="0,0,0,0"  VerticalAlignment="Stretch" VerticalContentAlignment="Top" IsReadOnly="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
                    </GroupBox>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Background="LightGreen"  >
                    <GroupBox x:Name="Message2" Header="Message2" Margin="0,0,-0.333,0" >
                        <RichTextBox x:Name="RichTextBox2" HorizontalAlignment="Stretch" Margin="0,0,0,0"  VerticalAlignment="Stretch" VerticalContentAlignment="Top" IsReadOnly="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
                    </GroupBox>
                </Border>
                <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Background="LightSeaGreen">
                    <Grid.RowDefinitions >
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions >
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label   x:Name="Label1"                  Grid.Row="0" Grid.Column="0" Content="Server Name :"  Foreground="Black" FontSize="10"/>
                    <TextBox x:Name="TextBoxServerName"       Grid.Row="0" Grid.Column="1" Text="ServerName" TextAlignment="Right" ToolTip="Server Name" />
                    <Label   x:Name="Label2"                  Grid.Row="1" Grid.Column="0" Content="Server Listener Port :" Foreground="Black" FontSize="10"  />
                    <TextBox x:Name="TextBoxListenerPort"     Grid.Row="1" Grid.Column="1" Text="9951" TextAlignment="Right" ToolTip="Service Listener Port Number"   />
                    <Label   x:Name="Label3"                  Grid.Row="2" Grid.Column="0" Content="Send Data File Name :"  Foreground="Black" FontSize="10" Margin="0,0.2,0.4,0.2" />
                    <TextBox x:Name="TextBoxFileName"         Grid.Row="2" Grid.Column="1" Text="" TextAlignment="Right" ToolTip="Select Send File Name" />
                    <Button x:Name="BtnSelectFile"   Content="Select Send File" Grid.Row="0" Grid.Column="2" Click="BtnSelectFile_Click" />
                    <Button x:Name="BtnParsingFile"  Content="Parsing File"     Grid.Row="1" Grid.Column="2" Click="BtnParsingFile_Click" IsEnabled="False" />
                    <Button x:Name="BtnInitialFCB9GQIncomingMessage"     Content="Initial EAI FCB9GQ Incoming Message"      Grid.Row="2" Grid.Column="2" Click="BtnInitialFCB9GQIncomingMessage_Click" Height="22" Margin="0.2,0.2,0.2,0" VerticalAlignment="Top" />
                    <Button x:Name="BtnCommand4"     Content="BtnCommand4"      Grid.Row="3" Grid.Column="2" Click="BtnCommand4_Click" />
                    <Button x:Name="BtnCommand5"     Content="BtnCommand5"      Grid.Row="4" Grid.Column="2" />
                    <Button x:Name="BtnProcess"      Content="Process"          Grid.Row="0" Grid.Column="3" Click="BtnProcess_Click" IsEnabled="False" />
                    <Button x:Name="BtnCommand6"     Content="BtnCommand6"      Grid.Row="1" Grid.Column="3" Click="BtnCommand6_Click" />
                    <Button x:Name="BtnCommand7"     Content="BtnCommand7"      Grid.Row="2" Grid.Column="3" />
                    <Button x:Name="BtnCleanMessage" Content="Clean Message"    Grid.Row="3" Grid.Column="3" Click="BtnCleanMessage_Click"   />
                    <Button x:Name="BtnClosed"       Content="Closed"           Grid.Row="4" Grid.Column="3" Click="BtnClosed_Click"  />
                </Grid>
                <!--Splitter-->
                <!--<GridSplitter Grid.Row="1" Grid.Column="0" Background="Transparent" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Top"  Height="5" />-->
                <!--<GridSplitter Grid.Row="0" Grid.Column="0"  Background="Transparent"    HorizontalAlignment="Stretch"   VerticalAlignment="Stretch"  Height="5" />-->
                <GridSplitter Grid.Row="0" Grid.Column="0" Background="Transparent"                     HorizontalAlignment="Right"   VerticalAlignment="Stretch" Width="5"  />
            </Grid>
        </DockPanel>
    </Grid>
</Window>