<Window x:Class="Com.Cybersoft4u.Test.Wpf.WpfMQTest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MQ  Test" Height="660.8" Width="984" Icon="MQ.ico"  >
    <Window.Resources>
        <Style TargetType="DataGridColumnHeader" x:Key="CenterGridHeaderStyle">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="Blue"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="327*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <DockPanel MinHeight="50" MinWidth="50" LastChildFill="True" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" Grid.RowSpan="1" Width="NaN" Height="NaN" Name="DockPanel1">
            <!--Definition-->
            <StatusBar DockPanel.Dock="Bottom">
                <StatusBar.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </ItemsPanelTemplate>
                </StatusBar.ItemsPanel>
                <StatusBarItem>
                    <TextBlock Name="TextBlockMessage" Text="Ready" Foreground="Red"/>
                </StatusBarItem>
                <StatusBarItem Grid.Column="1">
                    <TextBlock Name="TextBlockTime" Text="Time"  Foreground="Blue"/>
                </StatusBarItem>
            </StatusBar>
            <Grid>
                <Grid.RowDefinitions >
                    <RowDefinition Height="3*" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions >
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <!--Panel-->
                <Border Grid.Row="0" Grid.Column="0" Background="LightGreen" >
                    <Grid  ShowGridLines="false" Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1.2*"></RowDefinition>
                            <RowDefinition Height="1.2*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Grid.Column="0" Background="LightGray" BorderThickness="0.2" >
                            <GroupBox x:Name="Message01" Header="Send"  >
                                <Grid ShowGridLines="false">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"></RowDefinition>
                                        <RowDefinition Height="*"></RowDefinition>
                                        <RowDefinition Height="*"></RowDefinition>
                                        <RowDefinition Height="*"></RowDefinition>
                                        <RowDefinition Height="*"></RowDefinition>
                                    </Grid.RowDefinitions>
                                    <Grid  Grid.Row="0" >
                                        <DockPanel  >
                                            <Label   Content="Queue Manager Name :"         Foreground="Blue"   Width="Auto" Height="Auto" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TextBoxSendQueueManagerName"   Foreground="Blue"   HorizontalAlignment="Stretch" VerticalAlignment="Center" Padding="5" Background="White" />
                                        </DockPanel>
                                    </Grid>
                                    <Grid  Grid.Row="1">
                                        <DockPanel >
                                            <Label   Content="Send Queue Name :"            Foreground="Blue"  Width="Auto" Height="Auto" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TextBoxSendQueueName"          Text=""            Foreground="Blue"   HorizontalAlignment="Stretch" VerticalAlignment="Center" Padding="5" Background="White"/>
                                        </DockPanel>
                                    </Grid>
                                    <Grid  Grid.Row="2">
                                        <DockPanel >
                                            <Label   Content="Channel Information :"        Foreground="Blue"  Width="Auto" Height="Auto" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TextBoxSendChannelInfo"        Text=""            Foreground="Blue"   HorizontalAlignment="Stretch" VerticalAlignment="Center" Padding="5" Background="White"/>
                                        </DockPanel>
                                    </Grid>
                                    <Grid  Grid.Row="3">
                                        <DockPanel >
                                            <Label   Content="Milliseconds to wait on GET :"   Foreground="Blue"  Width="Auto" Height="Auto" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TextBoxSendMilliSecOfGet"        Text=""            Foreground="Blue"   HorizontalAlignment="Stretch" VerticalAlignment="Center" Padding="5" Background="White"/>
                                        </DockPanel>
                                    </Grid>
                                    <Grid  Grid.Row="4">
                                        <DockPanel >
                                            <Button  Content="Select File Name"     Style="{StaticResource Btn-Primary}" Grid.Row="0" Grid.Column="0"  x:Name="BtnSelectFile"   Width="Auto" Height="Auto" Click="BtnSelectFile_Click" FontSize="10" />
                                            <TextBox x:Name="TextBoxSendSelectFileName"        Text=""            Foreground="Blue"   HorizontalAlignment="Stretch" VerticalAlignment="Center" Padding="5" Background="White"/>
                                        </DockPanel>
                                    </Grid>
                                </Grid>
                            </GroupBox>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="0" Background="LightGray" BorderThickness="0.2" >
                            <GroupBox x:Name="Message02" Header="Receive"  >
                                <Grid ShowGridLines="false">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"></RowDefinition>
                                        <RowDefinition Height="*"></RowDefinition>
                                        <RowDefinition Height="*"></RowDefinition>
                                        <RowDefinition Height="*"></RowDefinition>
                                    </Grid.RowDefinitions>
                                    <Grid  Grid.Row="0">
                                        <DockPanel >
                                            <Label   Content="Queue Manager Name :"            Foreground="Blue"  Width="Auto" Height="Auto" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TextBoxReceiveQueueManagerName"   Text=""     Foreground="Blue"   HorizontalAlignment="Stretch" VerticalAlignment="Center" Padding="5" Background="White"/>
                                        </DockPanel>
                                    </Grid>
                                    <Grid  Grid.Row="1">
                                        <DockPanel >
                                            <Label   Content="Receive Queue Name :"            Foreground="Blue"  Width="Auto" Height="Auto" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TextBoxReceiveQueueName"          Text=""     Foreground="Blue"   HorizontalAlignment="Stretch" VerticalAlignment="Center" Padding="5" Background="White"/>
                                        </DockPanel>
                                    </Grid>
                                    <Grid  Grid.Row="2">
                                        <DockPanel >
                                            <Label   Content="Channel Information :"           Foreground="Blue" Width="Auto"  Height="Auto" VerticalAlignment="Center" Margin="0,2,0,2.4" />
                                            <TextBox x:Name="TextBoxReceiveChannelInfo"       Text=""      Foreground="Blue"   HorizontalAlignment="Stretch" VerticalAlignment="Center" Padding="5" Background="White"/>
                                        </DockPanel>
                                    </Grid>
                                    <Grid  Grid.Row="3">
                                        <DockPanel >
                                            <Label   Content="Milliseconds to wait on GET :"   Foreground="Blue"  Width="Auto" Height="Auto" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TextBoxReceiveMilliSecOfGet"      Text=""        Foreground="Blue"   HorizontalAlignment="Stretch" VerticalAlignment="Center" Padding="5" Background="White"/>
                                        </DockPanel>
                                    </Grid>
                                </Grid>
                            </GroupBox>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="0" Background="LightGreen" BorderThickness="0.2" >
                            <GroupBox x:Name="Message03" Header="Command"  >
                                <Grid ShowGridLines="false">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"></RowDefinition>
                                        <RowDefinition Height="*"></RowDefinition>
                                        <RowDefinition Height="*"></RowDefinition>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="Initial"           Style="{StaticResource Btn-Primary}"         Grid.Row="0" Grid.Column="0"  ToolTip="Initial MQ Parameter"        x:Name="BtnInitial"            Width="Auto" Height="Auto" Click="BtnInitial_Click" />
                                    <Button Content="Reset"             Style="{StaticResource Btn-Primary}"         Grid.Row="0" Grid.Column="1"  ToolTip="Reset MQ Parameter"          x:Name="BtnReset"              Width="Auto" Height="Auto" Click="BtnReset_Click" />
                                    <TextBox x:Name="TextBoxRepeatCount"  Text="1"                                   Grid.Row="0" Grid.Column="2"  TextAlignment="Right" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
                                    <Button Content="Send Message"      Style="{StaticResource Btn-Primary}"         Grid.Row="1" Grid.Column="0"  ToolTip="Send MQ Message"             x:Name="BtnSend"               Width="Auto" Height="Auto" Click="BtnSend_Click" />
                                    <Button Content="One Receive Message"       Style="{StaticResource Btn-Primary}" Grid.Row="1" Grid.Column="1"  ToolTip="One Time Receive MQ Message" x:Name="BtnOneReceive"         Width="Auto" Height="Auto" Click="BtnOneReceive_Click" />
                                    <Button Content="Forever Receive Message"   Style="{StaticResource Btn-Primary}" Grid.Row="1" Grid.Column="2"  ToolTip="Forever Receive MQ Message"  x:Name="BtnForeverReceive"     Width="Auto" Height="Auto" Click="BtnForeverReceive_Click" />
                                    <Button Content="Create VD MQ Message" Style="{StaticResource Btn-Primary}"      Grid.Row="2" Grid.Column="2"  ToolTip="MQ Function Test"            x:Name="BtnCreateVDMQMessage"  Width="Auto" Height="Auto" Click="BtnCreateVDMQMessage_Click" />
                                    <Button Content="Clean Message"     Style="{StaticResource Btn-Primary}"         Grid.Row="2" Grid.Column="0"  ToolTip="Closed Windows"              x:Name="BtnCleanMessage"       Width="Auto" Height="Auto" Click="BtnCleanMessage_Click" />
                                    <Button Content="Closed"            Style="{StaticResource Btn-Primary}"         Grid.Row="2" Grid.Column="1"  ToolTip="Closed Windows"              x:Name="BtnClosed"             Width="Auto" Height="Auto" Click="BtnClosed_Click"/>
                                </Grid>
                            </GroupBox>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Background="LightGreen"  >
                    <GroupBox Header="Process Message" Margin="0,0,-0.333,0" >
                        <RichTextBox x:Name="RichTextBoxProcessMessage" HorizontalAlignment="Stretch" Margin="0,0,0,0"  VerticalAlignment="Stretch" VerticalContentAlignment="Top" IsReadOnly="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
                    </GroupBox>
                </Border>
                <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Background="LightGreen">
                    <GroupBox Header="Log Message" Margin="0,0,-0.333,0" >
                        <RichTextBox x:Name="RichTextBoxLogMessage" HorizontalAlignment="Stretch" Margin="0,0,0,0"  VerticalAlignment="Stretch" VerticalContentAlignment="Top" IsReadOnly="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
                    </GroupBox>
                </Grid>
                <!--Splitter-->
                <!--<GridSplitter Grid.Row="1" Grid.Column="0" Background="Transparent" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Top"  Height="5" />-->
                <!--<GridSplitter Grid.Row="0" Grid.Column="0"  Background="Transparent"    HorizontalAlignment="Stretch"   VerticalAlignment="Stretch"  Height="5" />-->
                <GridSplitter Grid.Row="0" Grid.Column="0" Background="Transparent"                     HorizontalAlignment="Right"   VerticalAlignment="Stretch" Width="5"  />
            </Grid>
        </DockPanel>
    </Grid>
</Window>