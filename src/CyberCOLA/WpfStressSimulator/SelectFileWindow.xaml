<Window x:Name="MainWindows" x:Class="Com.Cybersoft4u.Simulator.Wpf.WpfStressSimulator.SelectFileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SelectFileWindow" Height="247.2" Width="700" WindowStartupLocation="CenterScreen">
    <Grid Margin="0,0,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="0.2*" />
        </Grid.RowDefinitions>
        <DataGrid x:Name="DataGridSelectFile"
                  Grid.Row="0" Grid.Column="0"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Loaded="DataGridLoaded" Margin="0,0,0584,0.6">
        </DataGrid>
        <Button x:Name="BtnClosed"      Content="Closed"       Grid.Row="1"  Width="75" Margin="15,0.4,0,-0.4"  Click="BtnClosed_Click"      HorizontalAlignment="Left"/>
        <Button x:Name="BtnSelectAll"   Content="Select All"   Grid.Row="1"  Width="75" Margin="115,0.4,0,-0.4" Click="BtnSelectAll_Click"   HorizontalAlignment="Left"  />
        <Button x:Name="BtnUnSelectAll" Content="UnSelect All" Grid.Row="1"  Width="75" Margin="215,0.4,0,-0.4" Click="BtnUnSelectAll_Click" HorizontalAlignment="Left" />
    </Grid>
</Window>
