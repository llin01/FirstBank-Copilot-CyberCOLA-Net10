<Window x:Class="Com.Cybersoft4u.Simulator.Wpf.WpfStressSimulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Transaction Simulator" Height="500" Width="800" Icon="MasterCard.ico" Closed="Window_Closed"  >
    <Window.Resources>
        <Style TargetType="DataGridColumnHeader" x:Key="CenterGridHeaderStyle">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="Blue"/>
        </Style>
        <ControlTemplate x:Key="ExampleButton" TargetType="{x:Type Button}">
            <Border Background="LightGreen" BorderBrush="Black" BorderThickness="1" CornerRadius="5" x:Name="Border" Padding="10">
                <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Border" Property="Background" Value="Red" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>
    <Grid>
        <DockPanel MinHeight="50" MinWidth="50" LastChildFill="True" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Column="0" Grid.ColumnSpan="1" Grid.Row="0" Grid.RowSpan="1" Margin="0,0,0,0" Width="NaN" Height="NaN" Name="dockPanel1">
            <!--Definition-->
            <StatusBar DockPanel.Dock="Bottom">
                <StatusBar.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </ItemsPanelTemplate>
                </StatusBar.ItemsPanel>
                <StatusBarItem>
                    <TextBlock Name="TextBlockMessage" Text="Ready" Foreground="Red"/>
                </StatusBarItem>
                <StatusBarItem Grid.Column="1">
                    <TextBlock Name="TextBlockTime" Text="Time"  Foreground="Blue"/>
                </StatusBarItem>
            </StatusBar>
            <Grid>
                <Grid.RowDefinitions >
                    <RowDefinition Height="3*" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions >
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <!--Panel-->
                <Border Grid.Row="0" Grid.Column="0" Background="LightGreen" >
                    <GroupBox x:Name="Message1" Header="Message1" Margin="0,0,-0.333,0" >
                        <RichTextBox x:Name="RichTextBox1" HorizontalAlignment="Stretch" Margin="0,0,0,0"  VerticalAlignment="Stretch" VerticalContentAlignment="Top" IsReadOnly="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
                    </GroupBox>
                </Border>
                <Grid ShowGridLines="false" Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="LightGreen"  >
                        <GroupBox x:Name="Message2" Header="Message2" Margin="0,0,-0.333,0" >
                            <RichTextBox x:Name="RichTextBox2" HorizontalAlignment="Stretch" Margin="0,0,0,0"  VerticalAlignment="Stretch" VerticalContentAlignment="Top" IsReadOnly="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
                        </GroupBox>
                    </Border>
                    <Border Grid.Row="1" Background="LightGreen"  >
                        <GroupBox x:Name="Message3" Header="Message3" Margin="0,0,-0.333,0" >
                            <Grid>
                                <DataGrid AutoGenerateColumns="False" Background="White" ToolTip="Display Client Connection To Server Information" x:Name="DataGridRetrievalQueue" CanUserSortColumns="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Binding="{Binding QueueName}" Header="Queue Name" HeaderStyle="{StaticResource CenterGridHeaderStyle}" IsReadOnly="True" Width="160">
                                            <DataGridTextColumn.CellStyle>
                                                <Style>
                                                    <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.CellStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding QueueCount}" Header="Queue Count" HeaderStyle="{StaticResource CenterGridHeaderStyle}" IsReadOnly="True" Width="140">
                                            <DataGridTextColumn.CellStyle>
                                                <Style>
                                                    <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.CellStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </GroupBox>
                    </Border>
                </Grid>
                <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Background="LightSeaGreen">
                    <Grid.RowDefinitions >
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions >
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Label   x:Name="Label1"                                Grid.Row="0" Grid.Column="0" Content="Listener Port Number :"  Foreground="Black" FontSize="10" />
                    <ComboBox x:Name="ComboBoxListenerPort"                 Grid.Row="0" Grid.Column="1" ToolTip="Select Server Listener Port" SelectedIndex="0" HorizontalContentAlignment="Right">
                        <ListBoxItem Content="6036"/>
                        <ListBoxItem Content="6059"/>
                        <ListBoxItem Content="8001"/>
                        <ListBoxItem Content="8004"/>
                        <ListBoxItem Content="8005"/>
                        <ListBoxItem Content="8006"/>
                        <ListBoxItem Content="12801"/>
                        <ListBoxItem Content="13501"/>
                        <ListBoxItem Content="14801"/>
                        <ListBoxItem Content="15301"/>
                    </ComboBox>
                    <Label   x:Name="Label2"                                Grid.Row="1" Grid.Column="0" Content="Send Time Interval (Min:Max) Millisecond :" Foreground="Black" FontSize="10"  />
                    <TextBox x:Name="TextBoxSendIntervalMilliseconds"       Grid.Row="1" Grid.Column="1" Text="10000" TextAlignment="Right" ToolTip="Send Time Interval(Milliseconds)" />
                    <Label   x:Name="Label3"                                Grid.Row="2" Grid.Column="0" Content="Transaction Type :" Foreground="Black" FontSize="10" />
                    <ComboBox x:Name="ComboBoxTransactionType"              Grid.Row="2" Grid.Column="1" ToolTip="Select Transaction Type(FISC,IAG,MasterCard,NCCC,NCPS,STIN,TWIN,Visa)" SelectedIndex="0">
                        <ComboBoxItem Name="ItemFisc" >FISC</ComboBoxItem>
                        <ComboBoxItem Name="ItemIAG"  >IAG</ComboBoxItem>
                        <ComboBoxItem Name="ItemMasterCard" >MasterCard</ComboBoxItem>
                        <ComboBoxItem Name="ItemNccc" >NCCC</ComboBoxItem>
                        <ComboBoxItem Name="ItemNcps" >NCPS</ComboBoxItem>
                        <ComboBoxItem Name="ItemSTIN" >STIN</ComboBoxItem>
                        <ComboBoxItem Name="ItemTwin" >TWIN</ComboBoxItem>
                        <ComboBoxItem Name="ItemVisa" >Visa</ComboBoxItem>
                    </ComboBox>
                    <Label   x:Name="Label4"                                                     Grid.Row="3" Grid.Column="0" Content="Repeat Count :" Foreground="Black" FontSize="10" />
                    <TextBox x:Name="TextBoxRepeatCount"                                         Grid.Row="3" Grid.Column="1" Text="1" TextAlignment="Right" ToolTip="Create Queue data Repeat Count" />
                    <Label   x:Name="Label5"                                                     Grid.Row="4" Grid.Column="0" Content="Retrieval Interval (Sec) :" Foreground="Black" FontSize="10" />
                    <TextBox x:Name="TextBoxInterval"                                            Grid.Row="4" Grid.Column="1" Text="30" TextAlignment="Right" ToolTip="Retrieval Interval Of Queue" />
                    <Button x:Name="ButtonStart"               Content="Start Service"           Grid.Row="0" Grid.Column="2" Click="ButtonStart_Click" IsEnabledChanged="ButtonStart_IsEnabledChanged" FontWeight="Bold" />
                    <Button x:Name="ButtonStop"                Content="Stop Service"            Grid.Row="1" Grid.Column="2" Click="ButtonStop_Click" FontWeight="Bold" />
                    <Button x:Name="ButtonReset"               Content="Reset"                   Grid.Row="2" Grid.Column="2" Click="ButtonReset_Click" FontWeight="Bold" />
                    <Button x:Name="ButtonCleanMessage"        Content="Clean Message"           Grid.Row="3" Grid.Column="2" Click="ButtonCleanMessage_Click" FontWeight="Bold"  />
                    <Button x:Name="ButtonClosed"              Content="Closed"                  Grid.Row="4" Grid.Column="2" Click="ButtonClosed_Click" FontWeight="Bold" />
                    <Button x:Name="ButtonInitialQueueData"    Content="Initial Queue Data"      Grid.Row="0" Grid.Column="3" Click="ButtonInitialQueueData_Click" IsEnabledChanged="ButtonInitialQueueData_IsEnabledChanged" FontWeight="Bold" Height="23" VerticalAlignment="Top" />
                    <Button x:Name="ButtonGetQueueCount"       Content="Get Queue Count"         Grid.Row="1" Grid.Column="3" Click="ButtonGetQueueCount_Click"    IsEnabled="False" FontWeight="Bold" />
                    <Button x:Name="ButtonReCreateQueue"       Content="Re-Create Queue"         Grid.Row="2" Grid.Column="3" Click="ButtonReCreateQueue_Click" FontWeight="Bold" />
                    <Button x:Name="ButtonSetFolderLocation"   Content="Set Folder Location"     Grid.Row="3" Grid.Column="3" IsEnabled="True"  FontWeight="Bold" Click="ButtonSetFolderLocation_Click"/>
                    <Button x:Name="ButtonRetrievalQueue"      Content="Start Retrieval Queue"   Grid.Row="4" Grid.Column="3" IsEnabled="False" FontWeight="Bold" Click="ButtonRetrievalQueue_Click"/>
                </Grid>
                <!--Splitter-->
                <!--<GridSplitter Grid.Row="1" Grid.Column="0" Background="Transparent" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Top"  Height="5" />-->
                <!--<GridSplitter Grid.Row="0" Grid.Column="0"  Background="Transparent"    HorizontalAlignment="Stretch"   VerticalAlignment="Stretch"  Height="5" />-->
                <GridSplitter Grid.Row="0" Grid.Column="0" Background="Transparent"                     HorizontalAlignment="Right"   VerticalAlignment="Stretch" Width="5"  />
            </Grid>
        </DockPanel>
    </Grid>
</Window>