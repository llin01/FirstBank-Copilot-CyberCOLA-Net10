@page "/"
@implements IDisposable
@inject SMSWebApiServerManager Manager

<div style="display:flex; flex-direction:column; height:100vh; padding:20px; gap:16px; overflow:hidden; background:linear-gradient(135deg,#060a12 0%,#0f172a 100%);">

    <!-- ═══ HEADER ═══════════════════════════════════════════════════════ -->
    <div style="display:flex; justify-content:space-between; align-items:center; padding:12px 22px; background:rgba(17,24,39,0.7); backdrop-filter:blur(12px); border:1px solid rgba(148,163,184,0.08); border-radius:12px; box-shadow:0 4px 24px rgba(0,0,0,0.3);">
        <div style="display:flex; align-items:center; gap:12px;">
            <!-- SMS icon -->
            <svg style="width:28px;height:28px;color:var(--accent-blue);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
            </svg>
            <div style="display:flex; align-items:baseline;">
                <span style="font-size:1.8rem; font-weight:800; color:#ffffff; letter-spacing:-0.5px;">Web</span>
                <span style="font-size:1.1rem; font-weight:400; color:var(--accent-blue); margin-left:5px; opacity:0.85;">SMSWebApiServer</span>
            </div>
        </div>
        <span style="color:var(--accent-blue); font-family:var(--font-mono); font-size:14px; font-weight:600; background:rgba(56,189,248,0.08); padding:6px 14px; border-radius:6px; border:1px solid rgba(56,189,248,0.15); letter-spacing:0.5px;">
            SYSTEM TIME: @_currentTime
        </span>
    </div>

    <!-- ═══ STATUS BADGE + CONTROLS ═════════════════════════════════════ -->
    <div style="display:flex; gap:16px; align-items:stretch;">

        <!-- Status card -->
        <div style="background:var(--bg-card); border:1px solid var(--border-color); border-radius:12px; padding:20px 28px; display:flex; align-items:center; gap:16px; min-width:240px;">
            @{
                var (dotColor, glowColor, statusLabel) = Manager.IsRunning
                    ? ("var(--accent-green)", "rgba(74,222,128,0.55)", "RUNNING")
                    : Manager.StatusText == "Starting..." || Manager.StatusText == "Stopping..."
                        ? ("var(--accent-orange)", "rgba(251,146,60,0.55)", Manager.StatusText.ToUpper())
                        : ("var(--text-muted)", "rgba(148,163,184,0.2)", "STOPPED");
            }
            <div style="width:14px; height:14px; border-radius:50%; background:@dotColor; box-shadow:0 0 10px @glowColor; flex-shrink:0;"></div>
            <div>
                <span style="color:var(--text-muted); font-size:10px; text-transform:uppercase; display:block;">Server Status</span>
                <span style="font-family:var(--font-mono); font-size:16px; font-weight:700; color:@dotColor;">@statusLabel</span>
            </div>
        </div>

        <!-- URL config card -->
        <div style="background:var(--bg-card); border:1px solid var(--border-color); border-radius:12px; padding:16px 20px; flex:1; display:flex; flex-direction:column; gap:8px;">
            <span style="color:var(--text-muted); font-size:10px; text-transform:uppercase; font-weight:600;">API Base URL (editable when stopped)</span>
            <div style="display:flex; gap:10px; align-items:center;">
                <input type="text"
                       value="@Manager.ApiUrl"
                       @onchange="e => Manager.ApiUrl = e.Value?.ToString() ?? Manager.ApiUrl"
                       disabled="@Manager.IsRunning"
                       style="flex:1; background:var(--bg-input); border:1px solid rgba(255,255,255,0.07); border-radius:6px; color:var(--text-main); padding:8px 12px; font-family:var(--font-mono); font-size:13px; outline:none;" />
                <button @onclick="StartServer"
                        disabled="@Manager.IsRunning"
                        style="padding:9px 22px; border-radius:7px; font-size:12px; font-weight:700; border:none; cursor:pointer; background:linear-gradient(135deg,#10b981 0%,#059669 100%); color:#fff; transition:all 0.2s; @(Manager.IsRunning?"opacity:0.4;cursor:not-allowed;":"")">
                    ▶ Start
                </button>
                <button @onclick="StopServer"
                        disabled="@(!Manager.IsRunning)"
                        style="padding:9px 22px; border-radius:7px; font-size:12px; font-weight:700; border:none; cursor:pointer; background:linear-gradient(135deg,#ef4444 0%,#dc2626 100%); color:#fff; transition:all 0.2s; @(!Manager.IsRunning?"opacity:0.4;cursor:not-allowed;":"")">
                    ■ Stop
                </button>
            </div>
        </div>
    </div>

    <!-- ═══ SIMULATED RESPONSE PREVIEW ══════════════════════════════════ -->
    <div style="background:var(--bg-card); border:1px solid var(--border-color); border-radius:12px; padding:18px 22px; display:flex; flex-direction:column; gap:10px;">
        <h3 style="margin:0; font-size:13px; font-weight:700; text-transform:uppercase; color:var(--accent-blue);">Simulated SMS Response Template</h3>
        <div style="display:grid; grid-template-columns:repeat(5,1fr); gap:10px; font-size:11px;">
            @foreach (var (k, v) in _responsePreview)
            {
                <div style="background:rgba(0,0,0,0.2); border-radius:6px; padding:8px 12px; border:1px solid rgba(255,255,255,0.03);">
                    <span style="color:var(--text-muted); display:block; font-size:9px; text-transform:uppercase; margin-bottom:2px;">@k</span>
                    <span style="font-family:var(--font-mono); font-weight:600; color:var(--accent-green);">@v</span>
                </div>
            }
        </div>
    </div>

    <!-- ═══ DUAL LOG CONSOLES ════════════════════════════════════════════ -->
    <div style="display:flex; gap:16px; flex:1; min-height:0;">

        <!-- System Log -->
        <div style="flex:1; background:#05090f; border:1px solid var(--border-color); border-radius:12px; padding:14px 16px; display:flex; flex-direction:column; overflow:hidden;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
                <span style="font-size:11px; text-transform:uppercase; font-weight:700; color:var(--accent-blue);">System Logs</span>
                <button @onclick="ClearSysLogs" style="background:none; border:none; color:var(--text-muted); font-size:10px; cursor:pointer; text-decoration:underline;">Clear</button>
            </div>
            <div style="flex:1; overflow-y:auto; font-family:var(--font-mono); font-size:11px; line-height:1.55; white-space:pre-wrap;">
                @foreach (var log in _systemLogs)
                {
                    <div style="color:@ColorHex(log.Color);">@log.Msg</div>
                }
            </div>
        </div>

        <!-- Request Received Log -->
        <div style="flex:1; background:#05090f; border:1px solid var(--border-color); border-radius:12px; padding:14px 16px; display:flex; flex-direction:column; overflow:hidden;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
                <span style="font-size:11px; text-transform:uppercase; font-weight:700; color:var(--accent-orange);">Incoming POST Requests</span>
                <div style="display:flex; align-items:center; gap:10px;">
                    <span style="background:rgba(251,146,60,0.12); color:var(--accent-orange); font-size:10px; font-weight:700; padding:2px 8px; border-radius:12px; border:1px solid rgba(251,146,60,0.25);">
                        @_requestLogs.Count hits
                    </span>
                    <button @onclick="ClearReqLogs" style="background:none; border:none; color:var(--text-muted); font-size:10px; cursor:pointer; text-decoration:underline;">Clear</button>
                </div>
            </div>
            <div style="flex:1; overflow-y:auto; font-family:var(--font-mono); font-size:11px; line-height:1.55; color:#86efac; white-space:pre-wrap;">
                @foreach (var log in _requestLogs)
                {
                    <div>@log</div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private string _currentTime = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss");
    private Timer? _uiTimer;
    private readonly List<LogItem> _systemLogs = new();
    private readonly List<string> _requestLogs = new();

    // Static preview of the simulated response fields
    private readonly (string Key, string Value)[] _responsePreview =
    [
        ("SYS_ID",           "CyberCOLA"),
        ("SOURCE_ID",        "#11"),
        ("MSG_ID",           "<Guid>"),
        ("CELL_PHONE",       "0912345678"),
        ("SMS_NAME",         "OTP"),
        ("SMS_BODY",         "Simulation"),
        ("SMS_PROVIDER",     "EVERY8D"),
        ("SMS_STATUS",       "0"),
        ("SMS_STATUS_STRING","0000"),
        ("MNT_USER",         "SIM"),
        ("CREATE_USER",      "SIM"),
    ];

    protected override void OnInitialized()
    {
        Manager.OnSystemLog  += HandleSysLog;
        Manager.OnRequestLog += HandleReqLog;

        _uiTimer = new Timer(async _ =>
        {
            _currentTime = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss");
            await InvokeAsync(StateHasChanged);
        }, null, 0, 1000);
    }

    private async Task StartServer()
    {
        await Manager.StartAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task StopServer()
    {
        await Manager.StopAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void HandleSysLog(string msg, string color)
    {
        _systemLogs.Add(new LogItem(msg, color));
        if (_systemLogs.Count > 200) _systemLogs.RemoveAt(0);
        InvokeAsync(StateHasChanged);
    }

    private void HandleReqLog(string msg)
    {
        _requestLogs.Add(msg);
        if (_requestLogs.Count > 200) _requestLogs.RemoveAt(0);
        InvokeAsync(StateHasChanged);
    }

    private void ClearSysLogs() => _systemLogs.Clear();
    private void ClearReqLogs() => _requestLogs.Clear();

    private static string ColorHex(string c) => c switch
    {
        "green"  => "var(--accent-green)",
        "cyan"   => "var(--accent-blue)",
        "yellow" => "var(--accent-orange)",
        "red"    => "var(--accent-red)",
        "white"  => "#f1f5f9",
        _        => "var(--text-muted)"
    };

    public void Dispose()
    {
        Manager.OnSystemLog  -= HandleSysLog;
        Manager.OnRequestLog -= HandleReqLog;
        _uiTimer?.Dispose();
    }

    private record LogItem(string Msg, string Color);
}
