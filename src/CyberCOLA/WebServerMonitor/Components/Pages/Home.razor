@page "/"
@implements IDisposable
@using Com.Cybersoft4u.CyberUtils.Utils
@using Com.Cybersoft4u.CommonLib.Resource
@using NLog
@inject Com.Cybersoft4u.Test.Web.WebServerMonitor.ServerMonitorManager Manager
@inject Microsoft.Extensions.Hosting.IHostApplicationLifetime Lifetime

<div class="app-container">
    <!-- ===== Header ===== -->
    <header>
        <div class="logo-section">
            <img src="images/server_connect.ico" alt="Monitor" style="height: 32px; width: 32px; object-fit: contain; filter: drop-shadow(0 0 8px var(--primary-glow));" />
            <div style="display: flex; align-items: baseline; gap: 8px;">
                <span style="font-size: 1.8rem; font-weight: 800; color: var(--primary-color); text-transform: uppercase; font-family: var(--font-sans); display: inline-block; line-height: 1;">Web</span>
                <span style="font-size: 1.1rem; font-weight: 400; color: #64748b; font-family: var(--font-sans); display: inline-block; line-height: 1;">Server Monitor Console</span>
            </div>
        </div>

        <div style="display: flex; gap: 15px; align-items: center;">
            <div class="status-badge" style="border-color: @(_isServiceRunning ? "rgba(74,222,128,0.25)" : "rgba(239,68,68,0.25)");">
                <span style="color: @(_isServiceRunning ? "var(--accent-color)" : "#ef4444")">MONITOR SERVICE:</span>
                <span style="margin-left: 5px; font-weight: 600; color: var(--text-main);">@(_isServiceRunning ? "RUNNING" : "STOPPED")</span>
            </div>
            <div class="status-badge" style="border-color: rgba(56,189,248,0.25);">
                <span style="color: var(--primary-color); font-family: var(--font-mono); font-weight: 600;">SYSTEM TIME: @_currentTime</span>
            </div>
        </div>
    </header>

    <!-- ===== Dashboard Grid ===== -->
    <div class="dashboard-grid" style="grid-template-columns: 300px 1fr;">
        
        <!-- ===== Left: Control Center ===== -->
        <aside class="panel">
            <div class="panel-title">Service Controller</div>

            <!-- Service Actions -->
            <div class="form-group">
                <label>Monitor Engine</label>
                <div style="display: flex; flex-direction: column; gap: 8px; margin-top: 5px;">
                    <button class="btn btn-primary" disabled="@(_isExecuting || _isServiceRunning)" @onclick="StartService">
                        Start Monitor Service
                    </button>
                    <button class="btn btn-secondary" disabled="@(_isExecuting || !_isServiceRunning)" @onclick="StopService">
                        Stop Monitor Service
                    </button>
                </div>
            </div>

            <hr style="border: 0; border-top: 1px solid var(--border-color); margin: 15px 0;" />

            <!-- Command Sender Group -->
            <div class="form-group" style="display: flex; flex-direction: column; gap: 10px;">
                <label>TCP Command Terminal</label>
                
                <div>
                    <span style="font-size: 10px; color: var(--text-muted);">Select Target Connection</span>
                    <select class="form-control" @bind="_selectedTargetIp" style="font-family: var(--font-mono); font-size: 13px; margin-top: 3px; height: 38px; padding: 6px 12px; line-height: 1.5; color: #f1f5f9; background-color: #0f172a; border: 1px solid rgba(148, 163, 184, 0.25); border-radius: 6px;">
                        @if (!_isServiceRunning)
                        {
                            <option value="" style="background-color: #0f172a; color: #f1f5f9;">-- Monitor Service Stopped --</option>
                        }
                        else if (_activeConnections.Count == 0)
                        {
                            <option value="" style="background-color: #0f172a; color: #f1f5f9;">-- No Active Clients Connected --</option>
                        }
                        else
                        {
                            <option value="" style="background-color: #0f172a; color: #f1f5f9;">-- Choose Connection --</option>
                        }

                        @foreach (var conn in _activeConnections)
                        {
                            <option value="@conn.IPAddress" style="background-color: #0f172a; color: #f1f5f9;">[@conn.ClientType] @conn.IPAddress</option>
                        }
                    </select>
                </div>

                <div>
                    <span style="font-size: 11px; color: var(--text-muted); font-weight: 600;">Category</span>
                    <select class="form-control" @bind="_selectedCategory" style="font-family: var(--font-sans); font-size: 13px; margin-top: 3px; height: 38px; padding: 6px 12px; line-height: 1.5; color: #f1f5f9; background-color: #0f172a; border: 1px solid rgba(148, 163, 184, 0.25); border-radius: 6px;">
                        <option value="VISAService" style="background-color: #0f172a; color: #f1f5f9;">VISA Service</option>
                        <option value="MASTERCARDService" style="background-color: #0f172a; color: #f1f5f9;">MasterCard Service</option>
                        <option value="COLAService" style="background-color: #0f172a; color: #f1f5f9;">COLA Service</option>
                        <option value="NCCCService" style="background-color: #0f172a; color: #f1f5f9;">NCCC Service</option>
                        <option value="VISAClient" style="background-color: #0f172a; color: #f1f5f9;">VISA Client</option>
                        <option value="MASTERCARDClient" style="background-color: #0f172a; color: #f1f5f9;">MasterCard Client</option>
                        <option value="NCCCClient" style="background-color: #0f172a; color: #f1f5f9;">NCCC Client</option>
                    </select>
                </div>

                <div>
                    <span style="font-size: 11px; color: var(--text-muted); font-weight: 600;">Command Code</span>
                    <select class="form-control" @bind="_selectedCommand" style="font-family: var(--font-sans); font-size: 13px; margin-top: 3px; height: 38px; padding: 6px 12px; line-height: 1.5; color: #f1f5f9; background-color: #0f172a; border: 1px solid rgba(148, 163, 184, 0.25); border-radius: 6px;">
                        <option value="ConnectionStatus" style="background-color: #0f172a; color: #f1f5f9;">ConnectionStatus (Check Connection)</option>
                        <option value="ChangeKey" style="background-color: #0f172a; color: #f1f5f9;">ChangeKey (Rotate Cryptographic Key)</option>
                        <option value="Echo" style="background-color: #0f172a; color: #f1f5f9;">Echo (Heartbeat Ping)</option>
                    </select>
                </div>

                <button class="btn btn-success" style="margin-top: 5px;" disabled="@(string.IsNullOrEmpty(_selectedTargetIp) || !_isServiceRunning || _isExecuting)" @onclick="SendCommand">
                    Transmit Command
                </button>
            </div>

            <!-- Global Actions -->
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: auto; padding-top: 15px;">
                <button class="btn btn-secondary" @onclick="CleanLogs">Clean</button>
                <button class="btn btn-danger" @onclick="CloseConsole">Close</button>
            </div>
        </aside>

        <!-- ===== Right: Services Monitor Workspace ===== -->
        <main style="display: flex; flex-direction: column; gap: 20px; overflow: hidden; flex-grow: 1;">
            
            <!-- 1. Connection Grid Panel -->
            <section class="panel" style="padding: 15px; display: flex; flex-direction: column; gap: 12px; height: 260px;">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <div class="panel-title" style="margin-bottom: 0;">Active Netty Client Connections</div>
                    <div style="display: flex; gap: 15px; align-items: center;">
                        <!-- Auto retrieval toggle -->
                        <div style="display: flex; align-items: center; gap: 6px;">
                            <input type="checkbox" id="autoRetrieval" @bind="_isAutoRetrieval" style="width: 14px; height: 14px; cursor: pointer;" />
                            <label for="autoRetrieval" style="font-size: 11px; color: var(--text-muted); cursor: pointer; user-select: none; margin-bottom: 0;">Auto Retrieval Status</label>
                        </div>
                        <div style="display: flex; align-items: center; gap: 6px;">
                            <input type="checkbox" id="udpControl" checked="@_isUdpRunning" @onchange="ToggleUdpService" style="width: 14px; height: 14px; cursor: pointer;" />
                            <label for="udpControl" style="font-size: 11px; color: var(--text-muted); cursor: pointer; user-select: none; margin-bottom: 0;">UDP Listener Port (@_udpPort)</label>
                        </div>
                    </div>
                </div>

                <!-- Grid Layout (Gateway vs ClientAuth) -->
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; flex-grow: 1; overflow: hidden;">
                    
                    <!-- Left: Gateway List -->
                    <div style="display: flex; flex-direction: column; gap: 6px; overflow: hidden;">
                        <div style="font-size: 11px; font-weight: bold; color: var(--primary-color); text-transform: uppercase;">Gateway Services (@_gatewayList.Count)</div>
                        <div style="flex-grow: 1; overflow-y: auto; background: rgba(15,23,42,0.4); border: 1px solid var(--border-color); border-radius: 6px; padding: 8px;">
                            @if (_gatewayList.Count == 0)
                            {
                                <div style="font-size: 11px; color: var(--text-muted); text-align: center; padding-top: 30px;">No Gateway connection active.</div>
                            }
                            else
                            {
                                <table style="width: 100%; border-collapse: collapse; font-size: 11px;">
                                    <thead>
                                        <tr style="border-bottom: 1px solid rgba(255,255,255,0.05); color: var(--text-muted); font-weight: bold;">
                                            <th style="padding: 4px; text-align: left;">Endpoint</th>
                                            <th style="padding: 4px; text-align: center;">Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var gateway in _gatewayList)
                                        {
                                            <tr style="border-bottom: 1px solid rgba(255,255,255,0.02); height: 26px;">
                                                <td style="padding: 4px; font-family: var(--font-mono);">@gateway.IPAddress</td>
                                                <td style="padding: 4px; text-align: center;">
                                                    <span class="status-indicator @(gateway.Status.ToUpper() == "CONNECTED" ? "status-success" : "status-error")" style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 4px;"></span>
                                                    <span style="color: @(gateway.Status.ToUpper() == "CONNECTED" ? "#4ade80" : "#f87171")">@gateway.Status</span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        </div>
                    </div>

                    <!-- Right: ClientAuth List -->
                    <div style="display: flex; flex-direction: column; gap: 6px; overflow: hidden;">
                        <div style="font-size: 11px; font-weight: bold; color: var(--accent-color); text-transform: uppercase;">Client Auth Endpoints (@_clientAuthList.Count)</div>
                        <div style="flex-grow: 1; overflow-y: auto; background: rgba(15,23,42,0.4); border: 1px solid var(--border-color); border-radius: 6px; padding: 8px;">
                            @if (_clientAuthList.Count == 0)
                            {
                                <div style="font-size: 11px; color: var(--text-muted); text-align: center; padding-top: 30px;">No ClientAuth connection active.</div>
                            }
                            else
                            {
                                <table style="width: 100%; border-collapse: collapse; font-size: 11px;">
                                    <thead>
                                        <tr style="border-bottom: 1px solid rgba(255,255,255,0.05); color: var(--text-muted); font-weight: bold;">
                                            <th style="padding: 4px; text-align: left;">Endpoint</th>
                                            <th style="padding: 4px; text-align: center;">Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var client in _clientAuthList)
                                        {
                                            <tr style="border-bottom: 1px solid rgba(255,255,255,0.02); height: 26px;">
                                                <td style="padding: 4px; font-family: var(--font-mono);">@client.IPAddress</td>
                                                <td style="padding: 4px; text-align: center;">
                                                    <span class="status-indicator @(client.Status.ToUpper() == "CONNECTED" ? "status-success" : "status-error")" style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 4px;"></span>
                                                    <span style="color: @(client.Status.ToUpper() == "CONNECTED" ? "#4ade80" : "#f87171")">@client.Status</span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        </div>
                    </div>

                </div>
            </section>

            <!-- 2. Dual Log Consoles -->
            <section style="flex-grow: 1; display: grid; grid-template-columns: 1fr 1.2fr; gap: 20px; overflow: hidden; min-height: 250px;">
                
                <!-- UDP Log Console -->
                <div style="display: flex; flex-direction: column; gap: 4px; overflow: hidden;">
                    <label style="font-size: 11px; font-weight: 600; color: var(--text-muted); text-transform: uppercase;">UDP Server Log Messages</label>
                    <div class="console-box" style="flex-grow: 1; font-size: 11px; font-family: var(--font-mono); white-space: pre-wrap; overflow-y: auto;">@_udpLogText</div>
                </div>

                <!-- Process & Cmd Console -->
                <div style="display: flex; flex-direction: column; gap: 4px; overflow: hidden;">
                    <label style="font-size: 11px; font-weight: 600; color: var(--text-muted); text-transform: uppercase;">Command & Process Output</label>
                    <div class="console-box" style="flex-grow: 1; font-size: 11px; font-family: var(--font-mono); white-space: pre-wrap; overflow-y: auto; color: var(--accent-color);">@_processLogText</div>
                </div>

            </section>

        </main>
    </div>
</div>

@code {
    private static readonly Logger Log = LogManager.GetCurrentClassLogger();
    private string _currentTime = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss");
    private Timer? _clockTimer;
    private Timer? _retrievalTimer;

    private bool _isServiceRunning = false;
    private bool _isExecuting = false;
    private bool _isAutoRetrieval = true;
    private bool _isUdpRunning = false;
    private int _udpPort = 9005;

    // --- Active Connection Model ---
    public class ConnectionInfo
    {
        public string ClientType { get; set; } = string.Empty;
        public string IPAddress { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
    }

    private List<ConnectionInfo> _activeConnections = new();
    private List<ConnectionInfo> _gatewayList = new();
    private List<ConnectionInfo> _clientAuthList = new();

    // --- Inputs ---
    private string _selectedTargetIp = string.Empty;
    private string _selectedCategory = "VISAService";
    private string _selectedCommand = "ConnectionStatus";

    // --- Log text states ---
    private string _udpLogText = "";
    private string _processLogText = "";

    protected override void OnInitialized()
    {
        // 1. Clock timer
        _clockTimer = new Timer(_ =>
        {
            _currentTime = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss");
            InvokeAsync(StateHasChanged);
        }, null, 0, 1000);

        // 2. Retrieval polling timer (Check status every 3 seconds)
        _retrievalTimer = new Timer(async _ =>
        {
            if (_isServiceRunning && _isAutoRetrieval)
            {
                await RefreshConnections();
            }
        }, null, 0, 3000);

        // 3. Register events
        Manager.OnProcessLog += (msg, isErr) =>
        {
            var prefix = isErr ? "[ERROR] " : "[INFO] ";
            _processLogText += $"{prefix}{msg}\n";
            InvokeAsync(StateHasChanged);
        };

        Manager.OnUdpLogReceived += (log) =>
        {
            _udpLogText += $"{log}\n";
            InvokeAsync(StateHasChanged);
        };

        // 4. Load Configurations
        Manager.LoadConfigurations();

        // 5. Read UDP port configuration
        if (Manager.ServiceMonitorInfo?.UDPServiceInfo != null)
        {
            if (int.TryParse(Manager.ServiceMonitorInfo.UDPServiceInfo.ListenerPort.Trim(), out var port))
            {
                _udpPort = port;
            }
        }
    }

    private async Task StartService()
    {
        if (_isExecuting) return;
        _isExecuting = true;
        StateHasChanged();
        await Task.Delay(1);

        try
        {
            Manager.StartMonitorService();
            _isServiceRunning = true;
            
            // Auto start UDP service matching WPF CheckBox logic
            var loader = new ConfigurationLoaderRoot();
            string autoStartStr = loader.Get(SystemConstantData.ConfigSectionName.GeneralConfigSectionName, "IsServiceAutoStart") ?? "false";
            
            if (Convert.ToBoolean(autoStartStr.Trim()))
            {
                Manager.StartUdpService();
                _isUdpRunning = true;
            }

            await RefreshConnections();
        }
        catch (Exception ex)
        {
            _processLogText += $"[ERROR] Startup exception: {ex.Message}\n";
        }
        finally
        {
            _isExecuting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task StopService()
    {
        if (_isExecuting) return;
        _isExecuting = true;
        StateHasChanged();
        await Task.Delay(1);

        try
        {
            if (_isUdpRunning)
            {
                Manager.StopUdpService();
                _isUdpRunning = false;
            }
            Manager.StopMonitorService();
            _isServiceRunning = false;
            _activeConnections.Clear();
            _gatewayList.Clear();
            _clientAuthList.Clear();
        }
        catch (Exception ex)
        {
            _processLogText += $"[ERROR] Stop exception: {ex.Message}\n";
        }
        finally
        {
            _isExecuting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RefreshConnections()
    {
        try
        {
            var dict = Manager.GetConnections();
            
            var list = new List<ConnectionInfo>();
            foreach (var kv in dict)
            {
                string ip = kv.Key.Trim();
                string[] parts = ip.Split(':');
                bool isClientAuth = false;

                if (parts.Length > 1)
                {
                    isClientAuth = Manager.ClientAuthPorts.Contains(parts[1]);
                }

                list.Add(new ConnectionInfo
                {
                    ClientType = isClientAuth ? "ClientAuth" : "Gateway",
                    IPAddress = ip,
                    Status = kv.Value
                });
            }

            _activeConnections = list;
            _gatewayList = list.Where(c => c.ClientType == "Gateway").ToList();
            _clientAuthList = list.Where(c => c.ClientType == "ClientAuth").ToList();

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Log.Warn(ex, "Failed to refresh UI connection grids");
        }
    }

    private async Task SendCommand()
    {
        if (string.IsNullOrEmpty(_selectedTargetIp) || !_isServiceRunning || _isExecuting) return;

        _isExecuting = true;
        StateHasChanged();
        await Task.Delay(1);

        try
        {
            Manager.SendCommandToClient(_selectedTargetIp, _selectedCategory, _selectedCommand);
        }
        catch (Exception ex)
        {
            _processLogText += $"[ERROR] Send Command Exception: {ex.Message}\n";
        }
        finally
        {
            _isExecuting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ToggleUdpService(ChangeEventArgs e)
    {
        if (e.Value is bool isChecked)
        {
            if (isChecked)
            {
                Manager.StartUdpService();
                _isUdpRunning = true;
            }
            else
            {
                Manager.StopUdpService();
                _isUdpRunning = false;
            }
        }
    }

    private void CleanLogs()
    {
        _processLogText = "";
        _udpLogText = "";
        StateHasChanged();
    }

    private void CloseConsole()
    {
        if (_isUdpRunning)
        {
            Manager.StopUdpService();
        }
        Manager.StopMonitorService();
        Lifetime.StopApplication();
        System.Diagnostics.Process.GetCurrentProcess().Kill();
    }

    public void Dispose()
    {
        _clockTimer?.Dispose();
        _retrievalTimer?.Dispose();
        Manager.Dispose();
    }
}
