<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwExceptions="false"
      internalLogLevel="Off" internalLogFile="${tempdir}nlog-internal.log">

  <!-- <variable name="LogDirectory"      value="E:/FirstBank/Copilot/CyberCOLA_Net10/LogFiles/${shortdate}"/> -->
  <variable name="LogDirectory"                          value="E:/FirstBank/Copilot/CyberCOLA_Net10/LogFiles/NCCC/CyberGWNCCC/${shortdate}"/>
  <variable name="LogLookupDirectory"                    value="E:/FirstBank/Copilot/CyberCOLA_Net10/LogFiles/NCCC/CyberGWNCCC/Lookup"/>
  <variable name="CommonFatalDirectory"                  value="E:/FirstBank/Copilot/CyberCOLA_Net10/LogFiles/CyberCOLA/Fatal/Log/${shortdate}"/>
  <variable name="CyberGWNCCCLogName"                    value="CyberGWNCCC.log"/>
  <variable name="CyberGWNCCCErrorLogName"               value="CyberGWNCCC_Error.log"/>
  <variable name="CyberGWNCCCFatalLogName"               value="CyberGWNCCC_Fatal.log"/>
  <variable name="CyberGWNCCCLookupLogName"              value="CyberGWNCCCLookup"/>
  <variable name="CyberGWNCCCClientMonitorLogName"       value="CyberGWNCCC_ClientMonitor.log"/>
  <variable name="CyberGWNCCCNCCCLogName"                value="CyberGWNCCC_NCCCSession.log"/>
  <variable name="CyberGWNCCCCOLALogName"                value="CyberGWNCCC_COLASession.log"/>
  <targets>
    <target name="Console" xsi:type="Console" />
    <target name="ColoredConsole" xsi:type="ColoredConsole" useDefaultRowHighlightingRules="false"
            layout="[${longdate}][${level:uppercase=true:padding=-5}][${threadid:padding=3}][${logger}][${message}] ${exception:format=message,stacktrace:separator=*}">
            <highlight-row condition="level == LogLevel.Trace" foregroundColor="Green" />
            <highlight-row condition="level == LogLevel.Debug" foregroundColor="Green" />
            <highlight-row condition="level == LogLevel.Info"  foregroundColor="Green" />
            <highlight-row condition="level == LogLevel.Warn"  foregroundColor="Yellow" />
            <highlight-row condition="level == LogLevel.Error" foregroundColor="Yellow" />
            <highlight-row condition="level == LogLevel.Fatal" foregroundColor="Red" backgroundColor="White" />
    </target>
    <target name="FileError" xsi:type="File"
            fileName="${LogDirectory}/${CyberGWNCCCErrorLogName}"
            layout="[${longdate}][${level:uppercase=true:padding=-5}][${threadid:padding=-3}][${logger}][${message}] ${exception:format=message,stacktrace:separator=*}" />
    <target name="FileFatal" xsi:type="File"
            fileName="${LogDirectory}/${CyberGWNCCCFatalLogName}"
            layout="[${longdate}][${level:uppercase=true:padding=-5}][${threadid:padding=-3}][${logger}][${message}] ${exception:format=message,stacktrace:separator=*}" />
    <target name="CommonFatalFile" xsi:type="File"
            fileName="${CommonFatalDirectory}/${processname}_FatalFile.log"
            layout="[${longdate}][${level:uppercase=true:padding=-5}][${threadid:padding=-3}][${logger}][${message}] ${exception:format=message,stacktrace:separator=*}" />
    <target name="Lookup" xsi:type="File"
            fileName="${LogLookupDirectory}/${CyberGWNCCCLookupLogName}_999999999999.log"
            archiveFileName="${LogLookupDirectory}/${CyberGWNCCCLookupLogName}_{#}.log"
            archiveNumbering="Date"
            archiveEvery="Minute"
            archiveDateFormat="yyyyMMddHHmm"
            layout="[${longdate}][${level:uppercase=true:padding=-5}][${threadid:padding=-3}][${logger}][${message}] ${exception:format=message,stacktrace:separator=*}" />
    <target name="FileClientMonitorSession" xsi:type="File"
            fileName="${LogDirectory}/${CyberGWNCCCClientMonitorLogName}"
            layout="[${longdate}][${level:uppercase=true:padding=-5}][${threadid:padding=-3}][${logger}][${message}] ${exception:format=message,stacktrace:separator=*}" />
    <target name="FileNCCCSession" xsi:type="File"
            fileName="${LogDirectory}/${CyberGWNCCCNCCCLogName}"
            layout="[${longdate}][${level:uppercase=true:padding=-5}][${threadid:padding=-3}][${logger}][${message}] ${exception:format=message,stacktrace:separator=*}" />
    <target name="FileCOLALession" xsi:type="File"
            fileName="${LogDirectory}/${CyberGWNCCCCOLALogName}"
            layout="[${longdate}][${level:uppercase=true:padding=-5}][${threadid:padding=-3}][${logger}][${message}] ${exception:format=message,stacktrace:separator=*}" />
    <target name="FileCyberGWNCCC" xsi:type="File"
            fileName="${LogDirectory}/${CyberGWNCCCLogName}"
            layout="[${longdate}][${level:uppercase=true:padding=-5}][${threadid:padding=-3}][${logger}][${message}] ${exception:format=message,stacktrace:separator=*}" 
            maxArchiveFiles="10"
            archiveFileName="${LogDirectory}/${CyberGWNCCCLogName}_{####################}"
            archiveAboveSize="209715200"
            archiveNumbering="Rolling"
            />
  </targets>
  <rules>
    <logger name="*"  minlevel="Warn" writeTo="ColoredConsole" />
    <logger name="*"  level="Error" writeTo="FileError" />
    <logger name="*"  level="Fatal" writeTo="FileFatal" />
    <logger name="*"  minlevel="Error" writeTo="CommonFatalFile" />
    <logger name="*"  level="Fatal" writeTo="Lookup" />
    <logger name="*"  minlevel="Info" writeTo="FileClientMonitorSession" >
      <filters>
        <when condition="contains('${logger}','ClientMonitor')"     action="Log" />
        <when condition="not contains('${logger}','ClientMonitor')" action="Ignore" />
      </filters>
    </logger>
    <logger name="*"  minlevel="Info" writeTo="FileNCCCSession" >
      <filters>
        <when condition="contains('${logger}','NcccSession')"     action="Log" />
        <when condition="not contains('${logger}','NcccSession')"  action="Ignore" />
      </filters>
    </logger>
    <logger name="*"  minlevel="Info" writeTo="FileCOLALession" >
      <filters>
        <when condition="contains('${logger}','NcccColaService')"     action="Log" />
        <when condition="not contains('${logger}','NcccColaService')" action="Ignore" />
      </filters>
    </logger>
    <logger name="*" minlevel="Info" writeTo="FileCyberGWNCCC" >
    </logger>
    <logger name="*"  level="Info" writeTo="FileNetwork" >
      <filters>
        <when condition="contains('${message}','ChannelRead Process List Count')"                            action="IgnoreFinal" />
        <when condition="contains('${message}','WRITE ')       and contains('${message}','MTI[0800]')"       action="Log" />
        <when condition="contains('${message}','CHANNELREAD ') and contains('${message}','MTI[0810]')"       action="Log" />
        <when condition="not contains('${message}','MTI[0800]') or not contains('${message}','MTI[0810]')"   action="Ignore" />
        <when condition="not contains('${logger}','NcccSession')"    action="Ignore" />
        <when condition="contains('${logger}','LoggerHandler')"      action="Ignore" />
      </filters>
    </logger>
  </rules>
</nlog>
