<Window x:Class="Com.Cybersoft4u.Test.Wpf.WpfFunctionTest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Function Test" Height="512" Width="823" Icon="test.ico" WindowStartupLocation="CenterScreen" Closed="Window_Closed"  >
    <Window.Resources>
        <Style TargetType="DataGridColumnHeader" x:Key="CenterGridHeaderStyle">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="Blue"/>
        </Style>
        <ControlTemplate x:Key="ExampleButton" TargetType="{x:Type Button}">
            <Border Background="LightGreen" BorderBrush="Black" BorderThickness="1" CornerRadius="5" x:Name="Border" Padding="10">
                <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Border" Property="Background" Value="Red" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="TabItemStyle1" TargetType="{x:Type TabItem}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="Border" BorderThickness="1,1,1,0" CornerRadius="5,5,0,0"
                            Padding="25,5,25,5" Margin="0,0,0,0" BorderBrush="Gainsboro">
                            <ContentPresenter x:Name="ContentSite" ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="TextElement.Foreground" TargetName="ContentSite" Value="White"/>
                                <Setter TargetName="Border" Property="Background" Value="Blue"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="TextElement.Foreground" TargetName="ContentSite" Value="Blue"/>
                                <Setter TargetName="Border" Property="Background" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <DockPanel MinHeight="50" MinWidth="50" LastChildFill="True" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Column="0" Grid.ColumnSpan="1" Grid.Row="0" Grid.RowSpan="1" Margin="0,0,0,0" Width="NaN" Height="NaN" Name="dockPanel1">
            <!--Definition-->
            <StatusBar DockPanel.Dock="Bottom">
                <StatusBar.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </ItemsPanelTemplate>
                </StatusBar.ItemsPanel>
                <StatusBarItem>
                    <TextBlock Name="TextBlockMessage" Text="Ready" Foreground="Red"/>
                </StatusBarItem>
                <StatusBarItem Grid.Column="1">
                    <TextBlock Name="TextBlockTime" Text="Time"  Foreground="Blue"/>
                </StatusBarItem>
            </StatusBar>
            <Grid>
                <Grid.RowDefinitions >
                    <RowDefinition Height="3*" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions >
                    <ColumnDefinition Width="15*" />
                    <ColumnDefinition Width="116*"/>
                    <ColumnDefinition Width="131*" />
                </Grid.ColumnDefinitions>

                <!--Panel-->
                <Border Grid.Row="0" Grid.Column="0" Background="LightGreen" Grid.ColumnSpan="2" >
                    <GroupBox x:Name="Message1" Header="Message1" Margin="0,0,-0.333,0" >
                        <RichTextBox x:Name="RichTextBox1" HorizontalAlignment="Stretch" Margin="0,0,0,0"  VerticalAlignment="Stretch" VerticalContentAlignment="Top" IsReadOnly="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
                    </GroupBox>
                </Border>
                <Border Grid.Row="0" Grid.Column="2" Background="LightGreen"  >
                    <GroupBox x:Name="Message2" Header="Message2" Margin="0,0,-0.333,0" >
                        <RichTextBox x:Name="RichTextBox2" HorizontalAlignment="Stretch" Margin="0,0,0,0"  VerticalAlignment="Stretch" VerticalContentAlignment="Top" IsReadOnly="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
                    </GroupBox>
                </Border>
                <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Background="LightSeaGreen">
                    <Grid.RowDefinitions >
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions >
                        <ColumnDefinition Width="1.0*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="1.0*"/>
                        <ColumnDefinition Width="1.0*"/>
                        <ColumnDefinition Width="1.0*"/>
                        <ColumnDefinition Width="1.0*"/>
                    </Grid.ColumnDefinitions>
                    <Label   x:Name="Label1"                          Grid.Row="0" Grid.Column="0" Content="Process File Name :"  Foreground="Black" FontSize="9" />
                    <TextBox x:Name="TextBoxSelectFileName"           Grid.Row="0" Grid.Column="1" Text="" TextAlignment="Left"   HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
                    <Button  x:Name="BtnSelectFileName"               Grid.Row="0" Grid.Column="2" Content="Select File Name"  Click="BtnSelectFile_Click" />

                    <Label   x:Name="Label2"                          Grid.Row="1" Grid.Column="0" Content="Open File Location : "  Foreground="Black" FontSize="9" />
                    <TextBox x:Name="TextBoxSelectLocation"           Grid.Row="1" Grid.Column="1" Text="" TextAlignment="Left"   HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
                    <Button  x:Name="BtnSelectFileLocation"           Grid.Row="1" Grid.Column="2" Content="Select File Location" Click="BtnSelectFileLocation_Click" />

                    <Label   x:Name="Label3"                          Grid.Row="2" Grid.Column="0" Content="Parsing Data :" Foreground="Black" FontSize="9" />
                    <TextBox x:Name="TextBoxParsingData"              Grid.Row="2" Grid.Column="1" Text="" TextAlignment="Right"  HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
                    <Grid Grid.Row="2" Grid.Column="2" >
                        <CheckBox x:Name="CheckBoxParsingData"
                             Content="Parsing Data"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center" IsChecked="False"/>
                    </Grid>

                    <Label   x:Name="Label4"                          Grid.Row="3" Grid.Column="0" Content="HSM Function :"  Foreground="Black" FontSize="9" />
                    <ComboBox x:Name="ComboBoxHSMFunction"            Grid.Row="3" Grid.Column="1" ToolTip="HSM Function" SelectedIndex="0" HorizontalContentAlignment="Right" SelectionChanged="ComboBoxHSMFunction_SelectionChanged" />
                    <Grid Grid.Row="3" Grid.Column="2" >
                        <CheckBox x:Name="CheckBoxInclude2ByteLength"
                             Content="2-Bytes Length"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center" IsChecked="False"/>
                    </Grid>

                    <Label   x:Name="Label5"                          Grid.Row="4" Grid.Column="0" Content="電子票證 :" Foreground="Black" FontSize="9" />
                    <Grid Grid.Row="4" Grid.Column="2" >
                        <CheckBox x:Name="CheckBoxFiscData"
                             Content="FISC"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center" IsChecked="False"/>
                    </Grid>

                    <ComboBox x:Name="ComboBoxETicketFunction"        Grid.Row="4" Grid.Column="1" ToolTip="E-Ticket Function" SelectedIndex="0" HorizontalContentAlignment="Right" SelectionChanged="ComboBoxETicketFunction_SelectionChanged" />


                    <Label   x:Name="Label6"             Grid.Row="5" Grid.Column="0" Content="Label6 :" Foreground="Black" FontSize="9" />
                    <TextBox x:Name="TextBoxSample"      Grid.Row="5" Grid.Column="1" Text="" TextAlignment="Left"   HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />

                    <Button  x:Name="BtnNccc"            Grid.Row="0" Grid.Column="3" Content="NCCC"            Click="BtnNccc_Click"  />
                    <Button  x:Name="BtnNcccToken"       Grid.Row="0" Grid.Column="4" Content="NCCC Token"      Click="BtnNcccToken_Click"  />
                    <Button  x:Name="BtnNcccAuthFlow"    Grid.Row="0" Grid.Column="5" Content="NCCC AuthFlow"   Click="BtnNcccAuthFlow_Click" />

                    <Button  x:Name="BtnFISC"            Grid.Row="1" Grid.Column="3" Content="FISC"            Click="BtnFisc_Click" />
                    <Button  x:Name="BtnFiscToken"       Grid.Row="1" Grid.Column="4" Content="FISC Token"      Click="BtnFiscToken_Click" />
                    <Button  x:Name="BtnFiscAuthFlow"    Grid.Row="1" Grid.Column="5" Content="FISC AuthFlow"   Click="BtnFiscAuthFlow_Click" />

                    <Button  x:Name="BtnTwin"            Grid.Row="2" Grid.Column="3" Content="TWIN"            Click="BtnTwin_Click"           />
                    <Button  x:Name="BtnTwinToken"       Grid.Row="2" Grid.Column="4" Content="TWIN Token"      Click="BtnTwinToken_Click"     />
                    <Button  x:Name="BtnTwinAuthFlow"    Grid.Row="2" Grid.Column="5" Content="TWIN AuthFlow"   Click="BtnTwinAuthFlow_Click"  />


                    <Button  x:Name="BtnETicket"         Grid.Row="3" Grid.Column="3" Content="E-Ticket"        Click="BtnETicket_Click" />
                    <Button  x:Name="BtnTest2"           Grid.Row="3" Grid.Column="4" Content="E-Ticket AuthFlow"   Click="BtnETicketAuthFlow_Click" />
                    <Button  x:Name="BtnFunctionTest2"   Grid.Row="3" Grid.Column="5" Content="Function Test2"  Click="BtnFunctionTest2_Click" />

                    <Button  x:Name="BtnWebService"      Grid.Row="4" Grid.Column="3" Content="Web Service"     Click="BtnWebService_Click"    />
                    <Button  x:Name="BtnFunctionTest4"   Grid.Row="4" Grid.Column="4" Content="Function Test4"  Click="BtnFunctionTest4_Click" />
                    <Button  x:Name="BtnFunctionTest3"   Grid.Row="4" Grid.Column="5" Content="Function Test3"  Click="BtnFunctionTest3_Click" />

                    <Button  x:Name="BtnSearchLog"       Grid.Row="5" Grid.Column="3" Content="Search Log"      Click="BtnSearchLog_Click" />
                    <Button  x:Name="BtnCleanMessage"    Grid.Row="5" Grid.Column="4" Content="Clean Message"   Click="BtnCleanMessage_Click"  />
                    <Button  x:Name="BtnClosed"          Grid.Row="5" Grid.Column="5" Content="Closed"          Click="BtnClosed_Click"  />

                </Grid>
                <!--Splitter-->
                <!--<GridSplitter Grid.Row="1" Grid.Column="0" Background="Transparent" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Top"  Height="5" />-->
                <!--<GridSplitter Grid.Row="0" Grid.Column="0"  Background="Transparent"    HorizontalAlignment="Stretch"   VerticalAlignment="Stretch"  Height="5" />-->
                <GridSplitter Grid.Row="0" Grid.Column="1" Background="Transparent"                     HorizontalAlignment="Right"   VerticalAlignment="Stretch" Width="5"  />
            </Grid>
        </DockPanel>
    </Grid>
</Window>