<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Com.Cybersoft4u.Test.Wpf.WpfMaintGatewayTester.Views.MaintGatewayTesterHttpsPage"
      Title="MaintGatewayTesterHttps" Background="#2D2D30">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="MaintGatewayTesterHttps (SSL/TLS)" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,15"/>
            <DockPanel>
                <TextBlock Text="HTTPS URL: " VerticalAlignment="Center" Foreground="#DCDCDC" FontWeight="SemiBold"/>
                <TextBox Name="TxtUrl" Text="http://localhost:5102/api/test/send-xml" Margin="5,0" HorizontalAlignment="Stretch" 
                         Background="#3F3F46" Foreground="White" CaretBrush="White" BorderBrush="#555555" Padding="5,3"/>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Name="BtnTrigger" Content="Trigger API (GET)" MinWidth="120" Width="Auto" Click="BtnTrigger_Click" Margin="0,0,5,0"
                            Background="#4CAF50" Foreground="White" FontWeight="Bold" Padding="10,5" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Name="BtnSend" Content="Send Secure" MinWidth="120" Width="Auto" Click="BtnSend_Click" 
                            Background="#007ACC" Foreground="White" FontWeight="Bold" Padding="10,5" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="Request Body (JSON):" FontWeight="Bold" Foreground="#DCDCDC" Margin="0,0,0,5"/>
            <TextBox Name="TxtRequest" Height="120" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Text="" 
                     Background="#3F3F46" Foreground="#B9B9B9" CaretBrush="White" BorderBrush="#555555" Padding="5"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Response:" FontWeight="Bold" Foreground="#DCDCDC" Margin="0,0,0,5"/>
            <TextBox Name="TxtResponse" Grid.Row="1" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" IsReadOnly="True" 
                     Background="#1E1E1E" Foreground="#DCDCAA" FontFamily="Consolas" BorderBrush="#333333" Padding="5"/>
        </Grid>
    </Grid>
</Page>
