<Window x:Class="Com.Cybersoft4u.Simulator.Wpf.WpfHighStressSimulator.Views.SelectFileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Template Payload Selector" 
        Height="450" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="#0D1117" Foreground="#F0F6FC"
        FontFamily="Segoe UI, Microsoft JhengHei">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock x:Name="TextBlockTitle" Text="Select Template Payload Files" 
                   FontSize="18" FontWeight="Bold" Foreground="#58A6FF"
                   Margin="0,0,0,5"/>
        <TextBlock x:Name="TextBlockSubtitle" Grid.Row="1" Text="Please check the template packets you want to load into the Session queues:"
                   FontSize="12" Foreground="#8B949E" Margin="0,0,0,12"/>

        <!-- Files List -->
        <Border Grid.Row="2" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="5">
            <ListBox x:Name="ListBoxFiles" Background="Transparent" BorderThickness="0" Foreground="#F0F6FC">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding FileName}" 
                                  Foreground="#F0F6FC" FontSize="13" FontWeight="SemiBold"
                                  VerticalAlignment="Center" Margin="5"
                                  BorderBrush="#58A6FF" Background="White"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Select All" Click="ButtonSelectAll_Click" Width="100" Height="32" 
                    Background="#21262D" Foreground="#C9D1D9" BorderBrush="#30363D"
                    Margin="0,0,8,0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="Deselect All" Click="ButtonDeselectAll_Click" Width="100" Height="32" 
                    Background="#21262D" Foreground="#C9D1D9" BorderBrush="#30363D"
                    Margin="0,0,15,0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="Load Templates" Click="ButtonConfirm_Click" Width="130" Height="32" 
                    Background="#238636" Foreground="White" BorderThickness="0" FontWeight="Bold"
                    Margin="0,0,8,0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="Cancel" Click="ButtonCancel_Click" Width="90" Height="32" 
                    Background="#DA3633" Foreground="White" BorderThickness="0" FontWeight="Bold">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
