<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwExceptions="false"
      internalLogLevel="Off" internalLogFile="${tempdir}nlog-internal.log">

  <!-- <variable name="LogDirectory"      value="E:/FirstBank/Claude/CyberCOLA_Net10/LogFiles/${shortdate}"/> -->
  <variable name="LogDirectory"                                  value="E:/FirstBank/Claude/CyberCOLA_Net10/LogFiles/ServiceRouter/${shortdate}"/>
  <variable name="LogLookupDirectory"                            value="E:/FirstBank/Claude/CyberCOLA_Net10/LogFiles/ServiceRouter/Lookup"/>
  <variable name="CommonFatalDirectory"                          value="E:/FirstBank/Claude/CyberCOLA_Net10/LogFiles/CyberCOLA/Fatal/Log/${shortdate}"/>
  <variable name="ServiceRouterLogName"                          value="ServiceRouter.log"/>
  <variable name="ServiceRouterErrorLogName"                     value="ServiceRouter_Error.log"/>
  <variable name="ServiceRouterFatalLogName"                     value="ServiceRouter_Fatal.log"/>
  <variable name="ServiceRouterLookupLogName"                    value="ServiceRouterLookup"/>
  <variable name="ServiceRouterServerRouterServiceLogName"       value="ServiceRouter_ServerRouterService.log"/>
  <variable name="ServiceRouterClientRouterServiceLogName"       value="ServiceRouter_ClientRouterService.log"/>
  <targets>
    <target name="Console" xsi:type="Console" />
    <target name="ColoredConsole" xsi:type="ColoredConsole" useDefaultRowHighlightingRules="false"
            layout="[${longdate}][${level:uppercase=true:padding=-5}][${threadid:padding=3}][${logger}][${message}] ${exception:format=message,stacktrace:separator=*}">
            <highlight-row condition="level == LogLevel.Trace" foregroundColor="Green" />
            <highlight-row condition="level == LogLevel.Debug" foregroundColor="Green" />
            <highlight-row condition="level == LogLevel.Info"  foregroundColor="Green" />
            <highlight-row condition="level == LogLevel.Warn"  foregroundColor="Yellow" />
            <highlight-row condition="level == LogLevel.Error" foregroundColor="Yellow" />
            <highlight-row condition="level == LogLevel.Fatal" foregroundColor="Red" backgroundColor="White" />
    </target>
    <target name="FileError" xsi:type="File"
            fileName="${LogDirectory}/${ServiceRouterErrorLogName}"
            layout="[${longdate}][${level:uppercase=true:padding=-5}][${threadid:padding=-3}][${logger}][${message}] ${exception:format=message,stacktrace:separator=*}" />
    <target name="FileFatal" xsi:type="File"
            fileName="${LogDirectory}/${ServiceRouterFatalLogName}"
            layout="[${longdate}][${level:uppercase=true:padding=-5}][${threadid:padding=-3}][${logger}][${message}] ${exception:format=message,stacktrace:separator=*}" />
    <target name="CommonFatalFile" xsi:type="File"
            fileName="${CommonFatalDirectory}/${processname}_FatalFile.log"
            layout="[${longdate}][${level:uppercase=true:padding=-5}][${threadid:padding=-3}][${logger}][${message}] ${exception:format=message,stacktrace:separator=*}" />
    <target name="Lookup" xsi:type="File"
            fileName="${LogLookupDirectory}/${ServiceRouterLookupLogName}_999999999999.log"
            archiveFileName="${LogLookupDirectory}/${ServiceRouterLookupLogName}_{#}.log"
            archiveNumbering="Date"
            archiveEvery="Minute"
            archiveDateFormat="yyyyMMddHHmm"
            layout="[${longdate}][${level:uppercase=true:padding=-5}][${threadid:padding=-3}][${logger}][${message}] ${exception:format=message,stacktrace:separator=*}" />
    <target name="FileServerRouterService" xsi:type="File"
            fileName="${LogDirectory}/${ServiceRouterServerRouterServiceLogName}"
            layout="[${longdate}][${level:uppercase=true:padding=-5}][${threadid:padding=-3}][${logger}][${message}] ${exception:format=message,stacktrace:separator=*}" />
    <target name="FileClientRouterService" xsi:type="File"
            fileName="${LogDirectory}/${ServiceRouterClientRouterServiceLogName}"
            layout="[${longdate}][${level:uppercase=true:padding=-5}][${threadid:padding=-3}][${logger}][${message}] ${exception:format=message,stacktrace:separator=*}" />
    <target name="FileServiceRouter" xsi:type="File"
            fileName="${LogDirectory}/${ServiceRouterLogName}"
            layout="[${longdate}][${level:uppercase=true:padding=-5}][${threadid:padding=-3}][${logger}][${message}] ${exception:format=message,stacktrace:separator=*}" 
            maxArchiveFiles="10"
            archiveFileName="${LogDirectory}/${ServiceRouterLogName}_{####################}"
            archiveAboveSize="209715200"
            archiveNumbering="Rolling"
            />
  </targets>
  <rules>
    <logger name="*"  minlevel="Warn" writeTo="ColoredConsole" />
    <logger name="*"  level="Error" writeTo="FileError" />
    <logger name="*"  level="Fatal" writeTo="FileFatal" />
    <logger name="*"  minlevel="Error" writeTo="CommonFatalFile" />
    <logger name="*"  level="Fatal" writeTo="Lookup" />
    <logger name="*"  minlevel="Info" writeTo="FileServerRouterService" >
      <filters>
        <when condition="contains('${logger}','ServerRouterService')"     action="Log" />
        <when condition="not contains('${logger}','ServerRouterService')" action="Ignore" />
      </filters>
    </logger>
    <logger name="*"  minlevel="Info" writeTo="FileClientRouterService" >
      <filters>
        <when condition="contains('${logger}','ClientRouterService')"     action="Log" />
        <when condition="not contains('${logger}','ClientRouterService')" action="Ignore" />
      </filters>
    </logger>
    <logger name="*"  minlevel="Info" writeTo="FileServiceRouter" >
    </logger>
  </rules>
</nlog>
