    private void HandleSystemLog(string msg, string color)
    {
        _systemLogs.Add(new LogItem(msg, color));
        if (_systemLogs.Count > 150) _systemLogs.RemoveAt(0);
        InvokeAsync(StateHasChanged);
    }

    private void HandleUdpLog(string msg)
    {
        _udpLogs.Add(msg);
        if (_udpLogs.Count > 150) _udpLogs.RemoveAt(0);
        InvokeAsync(StateHasChanged);
    }

    private void HandleConnectionListUpdated()
    {
        // Keep selection state if possible, otherwise create new
        var currentGateways = _filteredGateways.ToDictionary(g => g.IPAddress, g => g.IsSelected);
        var currentClientAuths = _filteredClientAuths.ToDictionary(c => c.IPAddress, c => c.IsSelected);

        _filteredGateways = Manager.GatewayList.Select(ip => new ClientItem
        {
            IPAddress = ip,
            IsSelected = currentGateways.ContainsKey(ip) && currentGateways[ip]
        }).ToList();

        _filteredClientAuths = Manager.ClientAuthList.Select(ip => new ClientItem
        {
            IPAddress = ip,
            IsSelected = currentClientAuths.ContainsKey(ip) && currentClientAuths[ip]
        }).ToList();

        _allSelected = false;
        InvokeAsync(StateHasChanged);
    }

    private void StartTcp() => Manager.StartTcpService();
    private void StopTcp() => Manager.StopTcpService();

    private void StartUdp()
    {
        if (Manager.ClientServiceInfo != null)
        {
            var port = Convert.ToInt32(Manager.ClientServiceInfo.TCPClientServiceConfig.UDPListenerPort.Trim());
            Manager.StartUdpService(port);
        }
    }

    private void StopUdp() => Manager.StopUdpService();

    private async Task QueryChannelStatus()
    {
        await Manager.QueryChannelStatusAsync();
    }

    private void ChangeTab(string tab)
    {
        _activeTab = tab;
        _allSelected = false;
    }

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        _allSelected = e.Value != null && (bool)e.Value;
        if (_activeTab == "Gateway")
        {
            foreach (var c in _filteredGateways) c.IsSelected = _allSelected;
        }
        else
        {
            foreach (var c in _filteredClientAuths) c.IsSelected = _allSelected;
        }
    }

    private bool HasSelectedEntities()
    {
        if (_activeTab == "Gateway")
            return _filteredGateways.Any(g => g.IsSelected);
        else
            return _filteredClientAuths.Any(c => c.IsSelected);
    }

    private async Task ExecuteSendCommand()
    {
        if (!Manager.IsTcpConnected) return;

        // Parse command prefix
        var cmdCode = _selectedCommand.Split(new[] { "--" }, StringSplitOptions.RemoveEmptyEntries)[0].Trim();
        var categoryItemCode = _selectedCategoryItem;

        if (_selectedCategory == "G")
        {
            var selectedIps = _filteredGateways.Where(g => g.IsSelected).Select(g => g.IPAddress).ToList();
            if (!selectedIps.Any()) return;
            
            HandleSystemLog($"Sending command {cmdCode} to selected Gateways...", "cyan");
            await Manager.SendGatewayCommandAsync(selectedIps, _selectedCategory, categoryItemCode, cmdCode, _gwLocalPort);
        }
        else if (_selectedCategory == "C")
        {
            var selectedIps = _filteredClientAuths.Where(c => c.IsSelected).Select(c => c.IPAddress).ToList();
            if (!selectedIps.Any()) return;
            
            HandleSystemLog($"Sending command {cmdCode} to selected ClientAuths...", "cyan");
            await Manager.SendClientAuthCommandAsync(selectedIps, _selectedCategory, categoryItemCode, cmdCode);
        }
        else if (_selectedCategory == "R")
        {
            HandleSystemLog($"Sending Router Command {cmdCode}...", "cyan");
            await Manager.SendRouterCommandAsync(_selectedCategory, categoryItemCode, cmdCode);
        }
    }

    private void ClearSystemLogs() => _systemLogs.Clear();
    private void ClearUdpLogs() => _udpLogs.Clear();

    private string GetColorHex(string color) => color.ToLower() switch
    {
        "red" => "var(--accent-red)",
        "green" => "var(--accent-green)",
        "yellow" => "var(--accent-orange)",
        "cyan" => "var(--accent-blue)",
        "gray" => "var(--text-muted)",
        _ => "var(--text-main)"
    };

    public void Dispose()
    {
        Manager.OnSystemLog -= HandleSystemLog;
        Manager.OnUdpLog -= HandleUdpLog;
        Manager.OnConnectionListUpdated -= HandleConnectionListUpdated;
        
        _uiTimer?.Dispose();
        _autoQueryTimer?.Dispose();
    }

    public class ClientItem
    {
        public string IPAddress { get; set; } = string.Empty;
        public bool IsSelected { get; set; }
    }

    public class LogItem
    {
        public string Message { get; }
        public string Color { get; }

        public LogItem(string msg, string col)
        {
            Message = msg;
            Color = col;
        }
    }
