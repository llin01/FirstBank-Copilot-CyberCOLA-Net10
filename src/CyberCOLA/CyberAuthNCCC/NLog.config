<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwExceptions="false"
      internalLogLevel="Off" internalLogFile="${tempdir}nlog-internal.log">

  <!-- <variable name="LogDirectory"      value="E:/FirstBank/Claude/CyberCOLA_Net10/LogFiles/${shortdate}"/> -->
  <variable name="LogDirectory"                              value="E:/FirstBank/Claude/CyberCOLA_Net10/LogFiles/NCCC/CyberAuthNCCC/${shortdate}"/>
  <variable name="LogLookupDirectory"                        value="E:/FirstBank/Claude/CyberCOLA_Net10/LogFiles/NCCC/CyberAuthNCCC/Lookup"/>
  <variable name="CommonFatalDirectory"                      value="E:/FirstBank/Claude/CyberCOLA_Net10/LogFiles/CyberCOLA/Fatal/Log/${shortdate}"/>
  <variable name="CyberAuthNCCCLogName"                      value="CyberAuthNCCC.log"/>
  <variable name="CyberAuthNCCCErrorLogName"                 value="CyberAuthNCCC_Error.log"/>
  <variable name="CyberAuthNCCCFatalLogName"                 value="CyberAuthNCCC_Fatal.log"/>
  <variable name="CyberAuthNCCCLookupLogName"                value="CyberAuthNCCCLookup"/>
  <variable name="CyberAuthNCCCClientMonitorLogName"         value="CyberAuthNCCC_ClientMonitor.log"/>
  <variable name="CyberAuthNCCCClientAuthRouterLogName"      value="CyberAuthNCCC_ClientAuthRouter.log"/>
  <variable name="CyberAuthNCCCClientAuthNCCCQRCodeLogName"  value="CyberAuthNCCC_ClientAuthNCCCQRCode.log"/>
  <targets>
    <target name="Console" xsi:type="Console" />
    <target name="ColoredConsole" xsi:type="ColoredConsole" useDefaultRowHighlightingRules="false"
            layout="[${longdate}][${level:uppercase=true:padding=-5}][${threadid:padding=3}][${logger}][${message}] ${exception:format=message,stacktrace:separator=*}">
            <highlight-row condition="level == LogLevel.Trace" foregroundColor="Green" />
            <highlight-row condition="level == LogLevel.Debug" foregroundColor="Green" />
            <highlight-row condition="level == LogLevel.Info"  foregroundColor="Green" />
            <highlight-row condition="level == LogLevel.Warn"  foregroundColor="Yellow" />
            <highlight-row condition="level == LogLevel.Error" foregroundColor="Yellow" />
            <highlight-row condition="level == LogLevel.Fatal" foregroundColor="Red" backgroundColor="White" />
    </target>
    <target name="FileError" xsi:type="File"
            fileName="${LogDirectory}/${CyberAuthNCCCErrorLogName}"
            layout="[${longdate}][${level:uppercase=true:padding=-5}][${threadid:padding=-3}][${logger}][${message}] ${exception:format=message,stacktrace:separator=*}" />
    <target name="FileFatal" xsi:type="File"
            fileName="${LogDirectory}/${CyberAuthNCCCFatalLogName}"
            layout="[${longdate}][${level:uppercase=true:padding=-5}][${threadid:padding=-3}][${logger}][${message}] ${exception:format=message,stacktrace:separator=*}" />
    <target name="CommonFatalFile" xsi:type="File"
            fileName="${CommonFatalDirectory}/${processname}_FatalFile.log"
            layout="[${longdate}][${level:uppercase=true:padding=-5}][${threadid:padding=-3}][${logger}][${message}] ${exception:format=message,stacktrace:separator=*}" />
    <target name="Lookup" xsi:type="File"
            fileName="${LogLookupDirectory}/${CyberAuthNCCCLookupLogName}_999999999999.log"
            archiveFileName="${LogLookupDirectory}/${CyberAuthNCCCLookupLogName}_{#}.log"
            archiveNumbering="Date"
            archiveEvery="Minute"
            archiveDateFormat="yyyyMMddHHmm"
            layout="[${longdate}][${level:uppercase=true:padding=-5}][${threadid:padding=-3}][${logger}][${message}] ${exception:format=message,stacktrace:separator=*}" />
    <target name="FileClientMonitorSession" xsi:type="File"
            fileName="${LogDirectory}/${CyberAuthNCCCClientMonitorLogName}"
            layout="[${longdate}][${level:uppercase=true:padding=-5}][${threadid:padding=-3}][${logger}][${message}] ${exception:format=message,stacktrace:separator=*}" />
    <target name="FileClientAuthRouterSession" xsi:type="File"
            fileName="${LogDirectory}/${CyberAuthNCCCClientAuthRouterLogName}"
            layout="[${longdate}][${level:uppercase=true:padding=-5}][${threadid:padding=-3}][${logger}][${message}] ${exception:format=message,stacktrace:separator=*}" />
    <target name="FileCyberAuthNCCC" xsi:type="File"
            fileName="${LogDirectory}/${CyberAuthNCCCLogName}"
            layout="[${longdate}][${level:uppercase=true:padding=-5}][${threadid:padding=-3}][${logger}][${message}] ${exception:format=message,stacktrace:separator=*}"
            maxArchiveFiles="10"
            archiveFileName="${LogDirectory}/${CyberAuthNCCCLogName}_{####################}"
            archiveAboveSize="209715200"
            archiveNumbering="Rolling"
            />
	<target name="FileCyberAuthNCCCQRCodeSession" xsi:type="File"
			fileName="${LogDirectory}/${CyberAuthNCCCClientAuthNCCCQRCodeLogName}"
			layout="[${longdate}][${level:uppercase=true:padding=-5}][${threadid:padding=-3}][${logger}][${message}] ${exception:format=message,stacktrace:separator=*}" />
	<target name="UDPNetwork" xsi:type="NLogViewer"
	        includeSourceInfo="true"
            address="udp://192.168.120.87:9909"/>
  </targets>
  <rules>
    <logger name="*"  minlevel="Warn" writeTo="ColoredConsole" />
    <logger name="*"  minlevel="Info" writeTo="UDPNetwork" />
    <logger name="*"  level="Fatal" writeTo="Lookup" />
    <logger name="*"  level="Error" writeTo="FileError" />
    <logger name="*"  level="Fatal" writeTo="FileFatal" />
    <logger name="*"  minlevel="Error" writeTo="CommonFatalFile" />
    <logger name="*"  minlevel="Info" writeTo="FileClientMonitorSession" >
      <filters>
        <when condition="contains('${logger}','ClientAuthClientMonitor')"     action="Log" />
        <when condition="not contains('${logger}','ClientAuthClientMonitor')" action="Ignore" />
      </filters>
    </logger>
    <logger name="*"  minlevel="Info" writeTo="FileClientAuthRouterSession" >
      <filters>
        <when condition="contains('${logger}','ClientAuthRouterService')"     action="Log" />
        <when condition="not contains('${logger}','ClientAuthRouterService')" action="Ignore" />
      </filters>
    </logger>
	<logger name="*"  minlevel="Info" writeTo="FileCyberAuthNCCCQRCodeSession" >
	  <filters>
	    <when condition="contains('${logger}','CyberAuthNCCCQRCode')"     action="Log" />
		<when condition="not contain('${logger}','CyberAuthNCCCQRCode')" action="Ignore" />
	  </filters>
	</logger>
    <logger name="*"  minlevel="Info" writeTo="FileCyberAuthNCCC" >
    </logger>
  </rules>
</nlog>
