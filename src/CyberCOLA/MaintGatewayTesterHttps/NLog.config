<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Info"
      internalLogFile="${tempdir}nlog-internal-tester.log">

  <variable name="LogDirectory" value="E:/FirstBank/Claude/CyberCOLA_Net10/LogFiles/${shortdate}" />

  <targets>
    <target name="ColoredConsole" xsi:type="ColoredConsole" useDefaultRowHighlightingRules="false"
            layout="[${longdate}][${level:uppercase=true:padding=-5}][${threadid:padding=3}][${logger}][${message}] ${exception:format=tostring}">
      <highlight-row condition="level == LogLevel.Trace" foregroundColor="Gray" />
      <highlight-row condition="level == LogLevel.Debug" foregroundColor="Gray" />
      <highlight-row condition="level == LogLevel.Info"  foregroundColor="Cyan" />
      <highlight-row condition="level == LogLevel.Warn"  foregroundColor="Yellow" />
      <highlight-row condition="level == LogLevel.Error" foregroundColor="Red" />
      <highlight-row condition="level == LogLevel.Fatal" foregroundColor="Red" backgroundColor="White" />
    </target>

    <target name="File" xsi:type="File"
            fileName="${LogDirectory}/Tester.log"
            layout="[${longdate}][${level:uppercase=true:padding=-5}][${threadid:padding=3}][${logger}][${message}] ${exception:format=tostring}" />
  </targets>

  <rules>
    <logger name="*" minlevel="Debug" writeTo="ColoredConsole" />
    <logger name="*" minlevel="Info" writeTo="File" />
  </rules>
</nlog>
