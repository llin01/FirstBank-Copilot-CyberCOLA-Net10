@page "/"
@implements IDisposable
@inject Com.Cybersoft4u.Simulator.Web.WebVDMQSimulator.VDMQSimulatorManager Manager
@inject Microsoft.Extensions.Hosting.IHostApplicationLifetime Lifetime

<div class="app-container">
    <!-- ===== Header ===== -->
    <header>
        <div class="logo-section">
            <img src="images/ibm-mq.ico" alt="VDMQ" style="height: 32px; width: 32px; object-fit: contain; filter: drop-shadow(0 0 8px var(--primary-glow));" />
            <div style="display: flex; align-items: baseline; gap: 8px;">
                <span style="font-size: 1.8rem; font-weight: 800; color: var(--primary-color); text-transform: uppercase; font-family: var(--font-sans); display: inline-block; line-height: 1;">Web</span>
                <span style="font-size: 1.1rem; font-weight: 400; color: #64748b; font-family: var(--font-sans); display: inline-block; line-height: 1;">VDMQ Simulator</span>
            </div>
        </div>

        <div style="display: flex; gap: 15px; align-items: center;">
            <div class="status-badge">
                <span class="status-pulse @(Manager.IsRunning ? "active" : "stopped")"></span>
                <span>@(Manager.IsRunning ? "SERVICE RUNNING" : "SERVICE STOPPED")</span>
            </div>
            <div class="status-badge" style="border-color: rgba(56,189,248,0.25);">
                <span style="color: var(--primary-color); font-family: var(--font-mono); font-weight: 600;">SYSTEM TIME: @_currentTime</span>
            </div>
        </div>
    </header>

    <!-- ===== Dashboard Grid ===== -->
    <div class="dashboard-grid">
        
        <!-- ===== Left: Parameters Panel ===== -->
        <aside class="panel">
            <div class="panel-title">System Settings</div>

            <!-- Wait Interval -->
            <div class="form-group">
                <label>Wait Interval (ms)</label>
                <input type="number" class="form-control" @bind="_waitIntervalMilliSecs" disabled="@(Manager.IsRunning)" />
            </div>

            <!-- MQ Parameter Information Summary -->
            <div class="form-group" style="flex-grow: 1; display: flex; flex-direction: column; margin-top: 10px;">
                <label>MQ Parameters</label>
                <div style="background: rgba(15, 23, 42, 0.6); border: 1px solid var(--border-color); border-radius: 8px; padding: 12px; font-size: 11px; color: var(--text-muted); line-height: 1.6; font-family: var(--font-mono); overflow-y: auto; flex-grow: 1;">
                    @_mqDetails
                </div>
            </div>

            <!-- Action Buttons Grid -->
            <div style="display: flex; flex-direction: column; gap: 10px; margin-top: 15px;">
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                    <button class="btn btn-primary" disabled="@(Manager.IsRunning || _isStarting)" @onclick="StartService">Start</button>
                    <button class="btn btn-danger" disabled="@(!Manager.IsRunning || _isStopping)" @onclick="StopService">Stop</button>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                    <button class="btn btn-secondary" disabled="@(_isStarting || _isStopping)" @onclick="CleanMessages">Clean</button>
                    <!-- Close button uses standard btn-danger without inline gradient gradients -->
                    <button class="btn btn-danger" disabled="@(_isStarting || _isStopping)" @onclick="CloseApp">Close</button>
                </div>
            </div>
        </aside>

        <!-- ===== Right: Dual Console Layout ===== -->
        <main class="logger-panel-layout" style="flex-grow: 1;">
            
            <!-- Connection & Telemetry Logs (Message 2) -->
            <section class="panel" style="flex-grow: 1;">
                <div class="panel-title">System Connection Logs (Message 2)</div>
                <div id="system-console" class="console-box" style="height: 250px;">
                    @foreach (var log in _systemLogs)
                    {
                        <div class="console-line">@log</div>
                    }
                </div>
            </section>

            <!-- XML Transaction Details (Message 1) -->
            <section class="panel" style="flex-grow: 1;">
                <div class="panel-title">Transmission XML Details (Message 1)</div>
                <div id="detail-console" class="console-box" style="height: 300px;">
                    @foreach (var log in _detailLogs)
                    {
                        <div class="console-line info" style="border-bottom: 1px dashed rgba(56, 189, 248, 0.15); padding-bottom: 6px; margin-bottom: 6px;">@log</div>
                    }
                </div>
            </section>

        </main>
    </div>
</div>

@code {
    private string _currentTime = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss");
    private Timer? _clockTimer;
    private int _waitIntervalMilliSecs = 5000;
    private string _mqDetails = string.Empty;

    private readonly List<string> _systemLogs = new();
    private readonly List<string> _detailLogs = new();

    protected override void OnInitialized()
    {
        _waitIntervalMilliSecs = Manager.WaitIntervalMilliSecs;
        _mqDetails = Manager.GetMQDetails();

        // Register event log broadcast callbacks
        Com.Cybersoft4u.Simulator.Web.WebVDMQSimulator.VDMQLogBroadcaster.OnSystemLogAdded += HandleSystemLog;
        Com.Cybersoft4u.Simulator.Web.WebVDMQSimulator.VDMQLogBroadcaster.OnDetailLogAdded += HandleDetailLog;

        // Fetch logs history from Broadcaster
        _systemLogs.AddRange(Com.Cybersoft4u.Simulator.Web.WebVDMQSimulator.VDMQLogBroadcaster.GetSystemHistory());
        _detailLogs.AddRange(Com.Cybersoft4u.Simulator.Web.WebVDMQSimulator.VDMQLogBroadcaster.GetDetailHistory());

        // Standard Blazor clock tick
        _clockTimer = new Timer(_ =>
        {
            _currentTime = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss");
            InvokeAsync(StateHasChanged);
        }, null, 0, 1000);

        // Prepopulate connection parameters in connection console
        if (_systemLogs.Count == 0)
        {
            var mq = Com.Cybersoft4u.CommonLib.Resource.SingletonOfMQServerInfo.Instance.GetMQServerInfo().MQServers.MQServer[0];
            Com.Cybersoft4u.Simulator.Web.WebVDMQSimulator.VDMQLogBroadcaster.LogSystem($"MQQueueManagerListener[{mq.MQQueueManagerListener}]");
            Com.Cybersoft4u.Simulator.Web.WebVDMQSimulator.VDMQLogBroadcaster.LogSystem($"MQChannelInfoListener[{mq.MQChannelInfoListener}]");
            Com.Cybersoft4u.Simulator.Web.WebVDMQSimulator.VDMQLogBroadcaster.LogSystem($"MQPutQueueNam[{mq.MQPutQueueName}]");
            Com.Cybersoft4u.Simulator.Web.WebVDMQSimulator.VDMQLogBroadcaster.LogSystem($"MQGetQueueNam[{mq.MQGetQueueName}]");
            Com.Cybersoft4u.Simulator.Web.WebVDMQSimulator.VDMQLogBroadcaster.LogSystem($"MQServerCCSID[{mq.MQServerCCSID}]");
            Com.Cybersoft4u.Simulator.Web.WebVDMQSimulator.VDMQLogBroadcaster.LogSystem($"MQClientCCSID[{mq.MQClientCCSID}]");
            Com.Cybersoft4u.Simulator.Web.WebVDMQSimulator.VDMQLogBroadcaster.LogSystem($"MQWaitIntervalMilliSec[{mq.MQWaitIntervalMilliSec}]");
        }
    }

    private bool _isStarting = false;
    private bool _isStopping = false;

    private async Task StartService()
    {
        if (_isStarting || Manager.IsRunning) return;
        _isStarting = true;
        
        Com.Cybersoft4u.Simulator.Web.WebVDMQSimulator.VDMQLogBroadcaster.LogSystem("Start button clicked.");
        
        // Force Blazor UI to render the disabled button state immediately before running MQ connection
        StateHasChanged();
        await Task.Delay(1);
        
        try
        {
            await Task.Run(() => Manager.Start(_waitIntervalMilliSecs));
        }
        finally
        {
            _isStarting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task StopService()
    {
        if (_isStopping || !Manager.IsRunning) return;
        _isStopping = true;
        
        Com.Cybersoft4u.Simulator.Web.WebVDMQSimulator.VDMQLogBroadcaster.LogSystem("Stop button clicked.");
        
        // Force Blazor UI to render the disabled button state immediately
        StateHasChanged();
        await Task.Delay(1);
        
        try
        {
            await Task.Run(() => Manager.Stop());
        }
        finally
        {
            _isStopping = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void CleanMessages()
    {
        _systemLogs.Clear();
        _detailLogs.Clear();
        Com.Cybersoft4u.Simulator.Web.WebVDMQSimulator.VDMQLogBroadcaster.Clear();
        Com.Cybersoft4u.Simulator.Web.WebVDMQSimulator.VDMQLogBroadcaster.LogSystem("Clean button clicked.");
        StateHasChanged();
    }

    private void CloseApp()
    {
        Com.Cybersoft4u.Simulator.Web.WebVDMQSimulator.VDMQLogBroadcaster.LogSystem("Close button clicked.");
        Manager.Stop();
        Lifetime.StopApplication();
        System.Diagnostics.Process.GetCurrentProcess().Kill();
    }

    private void HandleSystemLog(string msg)
    {
        InvokeAsync(() =>
        {
            _systemLogs.Add(msg);
            if (_systemLogs.Count > 150) _systemLogs.RemoveAt(0);
            StateHasChanged();
        });
    }

    private void HandleDetailLog(string msg)
    {
        InvokeAsync(() =>
        {
            _detailLogs.Add(msg);
            if (_detailLogs.Count > 200) _detailLogs.RemoveAt(0);
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Com.Cybersoft4u.Simulator.Web.WebVDMQSimulator.VDMQLogBroadcaster.OnSystemLogAdded -= HandleSystemLog;
        Com.Cybersoft4u.Simulator.Web.WebVDMQSimulator.VDMQLogBroadcaster.OnDetailLogAdded -= HandleDetailLog;
        _clockTimer?.Dispose();
    }
}
