<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <appSettings>
    <clear />
    <add key="tsb-system-parameter-info-xml-file-path"  value="F:\CyberSoft\TaishinBank\CyberCOLA\Config\SystemParameterInfo.xml" />
    <add key="tsb-resource-info-xml-file-path"          value="F:\CyberSoft\TaishinBank\CyberCOLA\Config\TSBResource.xml" />
    <add key="InitialDirectory"                         value="F:\CyberSoft\TaishinBank\CyberCOLA\All\WpfStressSimulator\Data" />
    <add key="CardXmlPrefixFileDirectory"               value="F:\CyberSoft\TaishinBank\CyberCOLA\All\WpfStressSimulator\Config" />
    <add key="ANRDataUpdateFilePath"                    value="F:\CyberSoft\TaishinBank\CyberCOLA\All\WpfStressSimulator\Data\ANRUpdateDataInfo.xml" />
    <add key="ListenPortList" value="6059,6063,7036,7059,8001,8004,8005,8006,8603,8700,8800,10325,12801,12880,13801,14801,13501,13901,15301,19325" />
    <add key="IsReplaceCardNumber" value="true" />
    <add key="IsReplaceOriginalData" value="true" />
    <add key="IsAutoEcho" value="false" />
    <add key="InitialRepeatCount" value="10" />
    <add key="MaintRemotePortList" value="10004" />
    <add key="ServerName" value="CFLin-NB-Test" />
    <add key="IsWaitingSignOn" value="false" />
    <add key="EchoIntervalInMilliSeconds" value="120000" />
    <add key="SessionCount" value="20" />
    <add key="PrefixQueueName" value=".\Private$\QRCodeStressQueue" />
    <add key="ReadQueueInterval" value="100" />
    <add key="SendIntervalInMilliSeconds" value="5000" />
    <add key="SendTimeOut" value="120" />
    <add key="ReceiveTimeOut" value="120" />
    <add key="SendMessageRepeatCount" value="1" />
    <!-- TransactionType ItemNccc,ItemNcps,ItemMastercard,ItemVisa,ItemIAG -->
    <add key="TransactionType" value="ItemNccc" />
    <!-- UDPPortNumber Visa=9001,MasterCard=9002,MasterCardANR=9003,Nccc=9004,Ncps=9005,Twmp=9006,IAG=9007,QRCode=9008  -->
    <add key="UDPPortNumber" value="9008" />
    <add key="RetrievalTimeIntervalSec" value="30" />
  </appSettings>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5" />
    </startup>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="log4net" publicKeyToken="669e0ddf0bb1aa2a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-1.2.15.0" newVersion="1.2.15.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
